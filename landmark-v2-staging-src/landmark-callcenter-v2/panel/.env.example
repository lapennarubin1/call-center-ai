# ═══════════════════════════════════════════════════════════════════════
#  Landmark Panel — plantilla de entorno
#
#  COPIAR a .env y rellenar:   cp .env.example .env && chmod 600 .env
#
#  Este fichero NO contiene ni un solo valor real y sí puede versionarse.
#  El .env, no.
#
#  NINGUNA contraseña tiene valor por defecto en el código. Si falta una
#  de las marcadas OBLIGATORIA, el panel NO arranca y dice cuál falta.
#  Es deliberado: un panel que arranca con credenciales desconocidas es
#  peor que un panel que no arranca.
#
#  Generar un valor aleatorio:   openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════════════

# ── Base de datos ──────────────────────────────────────────────────────
LM_DB_HOST=localhost
LM_DB_PORT=3306
LM_DB_USER=
LM_DB_PASS=                    # OBLIGATORIA — sin esto el panel no arranca
LM_DB_NAME=asterisk

# ── Servicio ───────────────────────────────────────────────────────────
# 8080 es producción. En staging usar 8081 y poner ESE puerto en el
# LM_PANEL_URL del n8n de staging (ver docs/INSTALL_STAGING.md).
LM_PORT=8080

# Tarifa por minuto por defecto del dashboard legado. No es una credencial.
LM_RATE=0.06

# ── Acceso al panel ────────────────────────────────────────────────────
# Los NOMBRES de usuario pueden tener valor por defecto: saber que el
# usuario se llama "master" no abre nada. Las contraseñas, no.
LM_USER=admin
LM_PASS=                       # OBLIGATORIA — rol viewer
LM_MASTER_USER=master
LM_MASTER_PASS=                # OBLIGATORIA — rol master
LM_SUPPORT_USER=support
LM_SUPPORT_PASS=               # OBLIGATORIA — rol support

# Clave de firma de la sesión. Si se deja vacía, el panel genera una y la
# ESCRIBE en app/.session_key — un secreto dentro del directorio de la
# aplicación. Con esta variable puesta, ese fichero no llega a crearse.
# Cambiarla sólo desloguea a todo el mundo; no afecta a datos ni llamadas.
LM_SECRET=                     # openssl rand -hex 32

# ── API de servicio (la que consume n8n) ───────────────────────────────
# Token que n8n manda en la cabecera X-Service-Token hacia /api/*.
# Tiene que coincidir con la credential "Landmark Panel API" de n8n.
LM_ROUTES_API_TOKEN=           # openssl rand -hex 32

# ── API de n8n (la que consulta el panel) ──────────────────────────────
# Necesaria para el modo de operación: volver de LEGACY_BACKUP a
# V2_PRIMARY VERIFICA contra n8n que ningún workflow legacy conflictivo
# siga corriendo. Sin esto, ese cambio queda bloqueado (fail closed).
LM_N8N_BASE_URL=
LM_N8N_API_KEY=

# ── Asterisk (sólo si se usa la gestión de extensiones) ────────────────
LM_AST_HOST=
LM_AST_PORT=
LM_AST_PJSIP_INCLUDE=
LM_AST_DIALPLAN_INCLUDE=

# ── Interruptores de arranque ──────────────────────────────────────────
# 1 = no arrancar ese hilo. Los tests los ponen a 1 para no pegarle a
# n8n ni a Telegram de verdad.
LM_SCHEDULER_DISABLED=0
LM_TELEGRAM_DISABLED=0

# Ruta a un SQLite alternativo. Vacío = usar MySQL. Sólo para desarrollo.
LM_SQLITE=

# ═══════════════════════════════════════════════════════════════════════
#  LO SIGUIENTE NO VA EN EL .env DEL PANEL
#  ─────────────────────────────────────────────────────────────────────
#  Son variables del entorno de n8n, no del panel. Se listan aquí para
#  que quien configure el sistema las tenga todas a la vista.
#
#    LM_PANEL_URL             base del panel vista desde n8n
#                             producción: http://172.18.0.1:8080
#    LM_LEADSTUDIO_URL        base de la API de LeadStudio
#    LM_STRINGEE_WORKER_URL   base del worker de Stringee
#    LM_WORKER_CALLBACK_TOKEN autentica el callback del worker
#    ELEVENLABS_API_KEY       polling de WF9 y descarga de audio de WF10
#    ELEVENLABS_WEBHOOK_SECRET  HMAC del post-call. SIN ESTO WF9 RECHAZA TODO
#    LM_OKPAY_MCH_ID          merchant id de OkPay
#    LM_OKPAY_SIGN_KEY        clave de firma de OkPay
#
#  Ninguna de ellas se guarda en la base de datos ni en el panel.
# ═══════════════════════════════════════════════════════════════════════
