# ══════════════════════════════════════════════════════════════
#  JARVIS — Configuración
#  Copiá este archivo a .env y completá los valores.
#  NUNCA subas el .env a git (ya está en .gitignore).
# ══════════════════════════════════════════════════════════════

# ── Identidad ────────────────────────────────────────────────
JARVIS_NAME=JARVIS
JARVIS_OPERATOR=

# ── Servidor ─────────────────────────────────────────────────
JARVIS_PORT=8090
# Generá una con:  python3 -c "import secrets;print(secrets.token_hex(32))"
JARVIS_SECRET_KEY=
JARVIS_USER=admin
JARVIS_PASS=CAMBIAME

# ── Cerebro (Anthropic) ──────────────────────────────────────
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-4-6
JARVIS_MAX_TOKENS=4096
JARVIS_MAX_TOOL_ROUNDS=8

# ── Voz (ElevenLabs) ─────────────────────────────────────────
ELEVENLABS_API_KEY=
JARVIS_VOICE_ENABLED=1
# Una voz por idioma — nunca se mezclan dentro de una respuesta.
# Listá las de tu cuenta con:  python3 -m app.tools voices
JARVIS_VOICE_DEFAULT=JBFqnCBsd6RMkjVDRZzb
JARVIS_VOICE_ES=
JARVIS_VOICE_EN=
JARVIS_VOICE_HI=
JARVIS_TTS_MODEL=eleven_turbo_v2_5
JARVIS_STT_MODEL=scribe_v1

# ── Base de datos del panel (métricas) ───────────────────────
LM_DB_HOST=localhost
LM_DB_USER=panel_rw
LM_DB_PASS=
LM_DB_NAME=asterisk
LM_DB_PORT=3306

# Base propia de Jarvis (memoria e historial)
JARVIS_DB_PATH=/opt/jarvis/data/jarvis.db

# ── Integraciones ────────────────────────────────────────────
LM_N8N_BASE_URL=
LM_N8N_API_KEY=
JARVIS_PANEL_URL=http://localhost:8080
JARVIS_ASTERISK=1

# ── Seguridad ────────────────────────────────────────────────
# 1 = las acciones que modifican el sistema piden confirmación.
# Dejalo en 1: evita que una frase mal escuchada apague un país.
JARVIS_CONFIRM_WRITES=1
