# /opt/saas_platform/backend/.env  — copiar a .env y completar. Permisos 600. NUNCA en git.
# ---- Base saas_platform (lectura/escritura) ----
SAAS_DB_HOST=host.docker.internal      # desde el contenedor: gateway hacia el MariaDB del host
SAAS_DB_HOST_LOCAL=127.0.0.1           # desde el host (scripts/migrate.sh)
SAAS_DB_PORT=3306
SAAS_DB_NAME=saas_platform
SAAS_DB_USER=saas_rw
SAAS_DB_PASS=CAMBIAR_password_fuerte_1

# ---- Base asterisk (SOLO lectura: cdr y sip_provider_pricing) ----
ASTERISK_RO_DB_NAME=asterisk
ASTERISK_RO_DB_USER=saas_ro_asterisk
ASTERISK_RO_DB_PASS=CAMBIAR_password_fuerte_2

# ---- Aplicacion ----
SAAS_SECRET_KEY=CAMBIAR_generar_con_openssl_rand_hex_32
SAAS_ENV=production                    # production | development
SAAS_LOG_LEVEL=INFO

# ---- Tenant inicial de validacion (solo lo usa el CLI create-tenant; agnostico del cliente) ----
SAAS_INITIAL_TENANT_SLUG=tenant-inicial
SAAS_INITIAL_TENANT_NAME=Tenant inicial de validacion
SAAS_INITIAL_ADMIN_USER=owner
SAAS_INITIAL_ADMIN_PASS=CAMBIAR_password_fuerte_3
