{% extends "base_app.html" %}
{% import "_icons.html" as ic %}
{% block title %}{{ 'Nuevo agente' if mode == 'create' else 'Editar agente' }} — AI Business Platform{% endblock %}
{% block content %}
<div class="page-header">
  <h1>{{ 'Nuevo agente' if mode == 'create' else 'Editar agente' }}</h1>
  <p>{{ 'Se crea en estado borrador (draft) — todavía sin llamadas reales.' if mode == 'create' else 'Los cambios no activan llamadas ni consumen créditos del motor de voz.' }}</p>
</div>

<div class="panel" style="max-width:640px">
  <div class="panel-header"><h2>Datos del agente</h2></div>
  <div style="padding:20px">

    <div id="form-alert" class="alert alert-error"></div>
    <div id="form-success" class="alert alert-success"></div>

    <form id="agent-form" data-mode="{{ mode }}" data-agent-id="{{ agent.id if agent else '' }}">
      <div class="field">
        <label for="name">Nombre del agente</label>
        <input type="text" id="name" name="name" required maxlength="120"
               value="{{ agent.name if agent else '' }}" placeholder="Ej. Agente Ventas MX">
      </div>

      <div class="field">
        <label for="description">Descripción (opcional)</label>
        <textarea id="description" name="description" rows="2" maxlength="500"
                  placeholder="Notas internas sobre este agente">{{ agent.description if agent and agent.description else '' }}</textarea>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
        <div class="field">
          <label for="country">País / mercado</label>
          <select id="country" name="country" required>
            <option value="" disabled {{ 'selected' if not agent }}>Seleccionar…</option>
            {% for code, label in country_choices %}
            <option value="{{ code }}" {{ 'selected' if agent and agent.country == code }}>{{ label }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="field">
          <label for="language">Idioma</label>
          <select id="language" name="language" required>
            <option value="" disabled {{ 'selected' if not agent }}>Seleccionar…</option>
            {% for code, label in language_choices %}
            <option value="{{ code }}" {{ 'selected' if agent and agent.language == code }}>{{ label }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
      <p style="font-size:12px;color:var(--text-muted);margin:-8px 0 16px">
        País e idioma son independientes: un agente en Kenya puede hablar inglés o swahili.
      </p>

      {% if mode == 'create' %}
      <div class="field">
        <label for="template">Template de prompt (opcional)</label>
        <select id="template">
          <option value="">Empezar en blanco…</option>
          {% for key, label in template_choices %}
          <option value="{{ key }}">{{ label }}</option>
          {% endfor %}
        </select>
      </div>
      {% endif %}

      <div class="field">
        <label for="first_message">First Message</label>
        <textarea id="first_message" name="first_message" rows="3" maxlength="1000"
                  placeholder="Lo primero que dice el agente al iniciar la conversación…">{{ agent.first_message if agent and agent.first_message else '' }}</textarea>
        <div style="font-size:12px;color:var(--text-muted);margin-top:4px">
          Distinto del System Prompt — es el saludo/apertura, no las instrucciones generales.
        </div>
      </div>

      <div class="field">
        <label for="system_prompt">System Prompt</label>
        <textarea id="system_prompt" name="system_prompt" rows="10" maxlength="6000"
                  placeholder="Instrucciones que va a seguir el agente en la conversación…">{{ agent.system_prompt if agent and agent.system_prompt else '' }}</textarea>
        <div style="font-size:12px;color:var(--text-muted);margin-top:4px">
          Se guarda únicamente en la plataforma — todavía no se sincroniza con ningún motor de voz externo.
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
        <div class="field">
          <label for="voice_provider">AI Voice Engine</label>
          <select id="voice_provider" name="voice_provider" required>
            <option value="elevenlabs" selected>Platform Voice</option>
          </select>
          {% if elevenlabs_mode %}
          <div style="font-size:12px;color:var(--text-muted);margin-top:4px">
            Modo: <strong>{{ 'Platform managed' if elevenlabs_mode == 'managed' else 'Bring your own key' }}</strong> ·
            <a href="{{ url_for('web.voice_elevenlabs_settings') }}">cambiar</a>
          </div>
          {% else %}
          <div style="font-size:12px;color:var(--warning);margin-top:4px">
            Sin configurar — <a href="{{ url_for('web.voice_elevenlabs_settings') }}">configurar Voice AI</a>
          </div>
          {% endif %}
        </div>
        <div class="field">
          <label for="voice_id">Voice ID (opcional)</label>
          <input type="text" id="voice_id" name="voice_id" maxlength="100"
                 value="{{ agent.voice_id if agent and agent.voice_id else '' }}"
                 placeholder="Pendiente de configurar">
          <div style="font-size:12px;color:var(--text-muted);margin-top:4px">
            Manual por ahora — la sincronización de voces reales llega en una fase futura.
          </div>
        </div>
      </div>

      <div class="field" id="external-agent-id-field">
        <label for="external_agent_id">External Agent Reference (opcional)</label>
        <input type="text" id="external_agent_id" name="external_agent_id" maxlength="120"
               value="{{ agent.external_agent_id if agent and agent.external_agent_id else '' }}"
               placeholder="ID del agente conversacional ya creado en tu proveedor de voz">
        <div style="font-size:12px;color:var(--text-muted);margin-top:4px">
          Referencia a un agente conversacional que ya existe en tu proveedor de voz — no se valida
          ni se consulta en esta etapa. Dejalo vacío para desvincularlo.
        </div>
      </div>

      {% if mode == 'create' %}
      <div class="field">
        <label>Estado inicial</label>
        <input type="text" value="draft (borrador)" disabled
               style="background:var(--neutral-soft);color:var(--text-muted)">
      </div>
      {% else %}
      <div class="field">
        <label for="status">Estado</label>
        <select id="status" name="status" required>
          {% for s in ['draft','disabled'] %}
          <option value="{{ s }}" {{ 'selected' if agent and agent.status == s }}>{{ s }}</option>
          {% endfor %}
        </select>
        <div style="font-size:12px;color:var(--text-muted);margin-top:4px">
          'active' todavía no está disponible en esta etapa del producto.
        </div>
      </div>
      {% endif %}

      <div class="form-actions">
        <a class="btn btn-ghost" href="{{ url_for('web.voice_agents') }}">Cancelar</a>
        <button type="submit" id="form-submit" class="btn btn-primary btn-auto">
          {{ 'Crear agente' if mode == 'create' else 'Guardar cambios' }}
        </button>
      </div>
    </form>
  </div>
</div>

{% if mode == 'create' %}
<script>
  window.__PROMPT_TEMPLATES__ = {{ prompt_templates | tojson }};
</script>
{% endif %}
{% endblock %}
