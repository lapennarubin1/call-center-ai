<style>
.ft-toggle {
    background: transparent;
    border: 2px solid currentColor;
    padding: 4px 12px;
    border-radius: 20px;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    transition: all 0.25s ease;
    opacity: 0.35;
    margin: 0 2px;
}
.ft-toggle.active {
    opacity: 1;
    color: #fff !important;
}
.ft-toggle.ft-answered.active { background: #2563eb; border-color: #2563eb; }
.ft-toggle.ft-realconv.active { background: #059669; border-color: #059669; }
.ft-toggle.ft-accounts.active { background: #dc2626; border-color: #dc2626; }
</style>
<script>
(function() {
    var svg = document.getElementById('funnel-trend-svg');
    if (!svg) return;

    var W = parseFloat(svg.dataset.w);
    var H = parseFloat(svg.dataset.h);
    var PAD_T = parseFloat(svg.dataset.padT);
    var PAD_B = parseFloat(svg.dataset.padB);
    var PLOT_H = H - PAD_B - PAD_T;

    function niceMax(v, steps) {
        steps = steps || 4;
        if (v <= 0) return steps;
        var mag = Math.pow(10, Math.floor(Math.log10(v)));
        var mags = [1, 1.5, 2, 2.5, 3, 4, 5, 7.5, 10];
        for (var i = 0; i < mags.length; i++) {
            if (mag * mags[i] >= v) return mag * mags[i];
        }
        return mag * 10;
    }

    function yOf(pct, yMax) {
        return PAD_T + PLOT_H - (PLOT_H * Math.min(pct, yMax) / yMax);
    }

    function recalcScale() {
        var groups = svg.querySelectorAll('.ft-series-group');
        var visiblePcts = [];

        groups.forEach(function(g) {
            if (g.dataset.visible === 'true') {
                var path = g.querySelector('.ft-path');
                var raw = JSON.parse(path.dataset.rawPoints || '[]');
                raw.forEach(function(p) { visiblePcts.push(p.pct); });
            }
        });

        var maxPct = visiblePcts.length > 0 ? Math.max.apply(null, visiblePcts) : 1;
        var yMax = niceMax(maxPct);
        if (yMax < 1) yMax = 1;

        var gridGroup = document.getElementById('ft-gridlines');
        gridGroup.innerHTML = '';
        for (var i = 0; i <= 4; i++) {
            var val = (yMax * i / 4);
            var y = yOf(val, yMax);
            var line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            line.setAttribute('class', 'grid');
            line.setAttribute('x1', '0');
            line.setAttribute('y1', y);
            line.setAttribute('x2', W);
            line.setAttribute('y2', y);
            gridGroup.appendChild(line);

            var text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            text.setAttribute('class', 'grid-label mono');
            text.setAttribute('x', '4');
            text.setAttribute('y', y - 4);
            text.textContent = (Math.round(val * 10) / 10) + '%';
            gridGroup.appendChild(text);
        }

        groups.forEach(function(g) {
            var isVisible = g.dataset.visible === 'true';
            var path = g.querySelector('.ft-path');
            var raw = JSON.parse(path.dataset.rawPoints || '[]');
            var newPath = 'M' + raw.map(function(p) {
                return p.x + ',' + yOf(p.pct, yMax);
            }).join(' L');
            path.setAttribute('d', newPath);

            var dots = g.querySelectorAll('.ft-dot');
            dots.forEach(function(dot, idx) {
                dot.setAttribute('cy', yOf(raw[idx].pct, yMax));
            });

            var labels = g.querySelectorAll('.ft-pt-label, .ft-last-label');
            labels.forEach(function(lbl) {
                var pct = parseFloat(lbl.dataset.pct);
                lbl.dataset.naturalY = yOf(pct, yMax) - 10;
            });

            g.style.opacity = isVisible ? '1' : '0';
        });

        // Anti-colisión: si quedan 2-3 líneas visibles con valores parecidos
        // en el mismo instante de tiempo, sus labels pueden pisarse al
        // recalcular. Se agrupan por X (mismo punto en el tiempo) y se
        // separan solo los que realmente chocan — mismo criterio que ya
        // se usa en el servidor para el dibujo inicial.
        var byX = {};
        svg.querySelectorAll('.ft-series-group[data-visible="true"] .ft-pt-label, .ft-series-group[data-visible="true"] .ft-last-label')
            .forEach(function(lbl) {
                var x = Math.round(parseFloat(lbl.getAttribute('x')));
                (byX[x] = byX[x] || []).push(lbl);
            });
        var MIN_GAP = 15;
        Object.keys(byX).forEach(function(x) {
            var lbls = byX[x].sort(function(a, b) {
                return parseFloat(a.dataset.naturalY) - parseFloat(b.dataset.naturalY);
            });
            var prevY = null;
            lbls.forEach(function(lbl) {
                var y = parseFloat(lbl.dataset.naturalY);
                if (prevY !== null && y < prevY + MIN_GAP) y = prevY + MIN_GAP;
                prevY = y;
                lbl.setAttribute('y', Math.min(Math.max(y, 10), H - 4));
            });
        });
    }

    window.toggleSeries = function(seriesName, btn) {
        btn.classList.toggle('active');
        var isActive = btn.classList.contains('active');
        var group = svg.querySelector('.ft-series-group[data-series="' + seriesName + '"]');
        if (group) {
            group.dataset.visible = isActive ? 'true' : 'false';
        }
        recalcScale();
    };

    recalcScale();
})();
</script>

<script>
(function() {
    var svg = document.getElementById('trace-svg');
    if (!svg) return;

    var W = parseFloat(svg.dataset.w);
    var H = parseFloat(svg.dataset.h);
    var PAD_T = parseFloat(svg.dataset.padT);
    var PAD_B = parseFloat(svg.dataset.padB);
    var PLOT_H = H - PAD_B - PAD_T;

    function niceMax(v, steps) {
        steps = steps || 4;
        if (v <= 0) return steps;
        var mag = Math.pow(10, Math.floor(Math.log10(v)));
        var mags = [1, 1.5, 2, 2.5, 3, 4, 5, 7.5, 10];
        for (var i = 0; i < mags.length; i++) {
            if (mag * mags[i] >= v) return mag * mags[i];
        }
        return mag * 10;
    }

    function recalcTrace() {
        var attemptsGroup = svg.querySelector('.tr-series-group[data-series="attempts"]');
        var answeredGroup = svg.querySelector('.tr-series-group[data-series="answered"]');
        var costGroup = svg.querySelector('.tr-series-group[data-series="cost"]');
        if (!attemptsGroup || !answeredGroup || !costGroup) return;

        var attemptsVisible = attemptsGroup.dataset.visible === 'true';
        var answeredVisible = answeredGroup.dataset.visible === 'true';
        var costVisible = costGroup.dataset.visible === 'true';

        // "attempts" y "answered" comparten el mismo eje de conteo — al
        // apagar una, la que queda se reescala a SU propio máximo para
        // ocupar todo el espacio. "cost" vive en su propio eje en dólares
        // y no necesita reescalarse por esto (nada más comparte su escala).
        var vals = [];
        if (attemptsVisible) {
            attemptsGroup.querySelectorAll('.b-tot').forEach(function(r) { vals.push(parseFloat(r.dataset.raw)); });
        }
        if (answeredVisible) {
            answeredGroup.querySelectorAll('.b-ans').forEach(function(r) { vals.push(parseFloat(r.dataset.raw)); });
        }

        if (vals.length > 0) {
            var yMax = niceMax(Math.max.apply(null, vals));

            var gridGroup = document.getElementById('tr-gridlines');
            gridGroup.innerHTML = '';
            for (var i = 0; i <= 4; i++) {
                var y = PAD_T + PLOT_H - (PLOT_H * (yMax * i / 4) / yMax);
                var line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                line.setAttribute('class', 'grid');
                line.setAttribute('x1', '0'); line.setAttribute('y1', y);
                line.setAttribute('x2', W); line.setAttribute('y2', y);
                gridGroup.appendChild(line);
            }
            var peakEl = document.getElementById('tr-peak-axis');
            if (peakEl) peakEl.textContent = 'peak axis ' + Math.round(yMax).toLocaleString();

            attemptsGroup.querySelectorAll('.b-tot').forEach(function(r) {
                var v = parseFloat(r.dataset.raw);
                var h = PLOT_H * Math.min(v, yMax) / yMax;
                r.setAttribute('height', h);
                r.setAttribute('y', PAD_T + PLOT_H - h);
            });
            answeredGroup.querySelectorAll('.b-ans').forEach(function(r) {
                var v = parseFloat(r.dataset.raw);
                var h = PLOT_H * Math.min(v, yMax) / yMax;
                r.setAttribute('height', h);
                r.setAttribute('y', PAD_T + PLOT_H - h);
            });

            svg.querySelectorAll('.tr-attempts').forEach(function(lbl) {
                if (lbl.tagName !== 'text') return;
                var cx = parseFloat(lbl.getAttribute('x'));
                var match = null;
                attemptsGroup.querySelectorAll('.b-tot').forEach(function(r) {
                    if (Math.abs(parseFloat(r.dataset.cx) - cx) < 0.5) match = r;
                });
                if (match) lbl.dataset.naturalY = parseFloat(match.getAttribute('y')) - 6;
            });
        }

        attemptsGroup.style.opacity = attemptsVisible ? '1' : '0';
        answeredGroup.style.opacity = answeredVisible ? '1' : '0';
        costGroup.style.opacity = costVisible ? '1' : '0';

        svg.querySelectorAll('.tr-cost').forEach(function(lbl) {
            if (lbl.tagName !== 'text') return;
            if (!lbl.dataset.naturalY) lbl.dataset.naturalY = lbl.getAttribute('y');
        });

        // Anti-colisión entre labels visibles en la misma columna (X) —
        // mismo criterio que ya usa el gráfico de funnel over time.
        var byX = {};
        svg.querySelectorAll('.tr-series-group[data-visible="true"] .tr-pt-label, .tr-series-group[data-visible="true"] .tr-last-label')
            .forEach(function(lbl) {
                if (!lbl.dataset.naturalY) lbl.dataset.naturalY = lbl.getAttribute('y');
                var x = Math.round(parseFloat(lbl.getAttribute('x')));
                (byX[x] = byX[x] || []).push(lbl);
            });
        var MIN_GAP = 15;
        Object.keys(byX).forEach(function(x) {
            var lbls = byX[x].sort(function(a, b) { return parseFloat(a.dataset.naturalY) - parseFloat(b.dataset.naturalY); });
            var prevY = null;
            lbls.forEach(function(lbl) {
                var y = parseFloat(lbl.dataset.naturalY);
                if (prevY !== null && y < prevY + MIN_GAP) y = prevY + MIN_GAP;
                prevY = y;
                lbl.setAttribute('y', Math.min(Math.max(y, 10), H - 4));
            });
        });
    }

    window.toggleTrace = function(seriesName, btn) {
        btn.classList.toggle('active');
        var isActive = btn.classList.contains('active');
        var group = svg.querySelector('.tr-series-group[data-series="' + seriesName + '"]');
        if (group) group.dataset.visible = isActive ? 'true' : 'false';
        recalcTrace();
    };

    recalcTrace();
})();
</script>

<script>
(function() {
    var svg = document.getElementById('hourly-svg');
    if (!svg) return;

    var H = parseFloat(svg.dataset.h);
    var PAD_T = parseFloat(svg.dataset.padT);
    var PAD_B = parseFloat(svg.dataset.padB);
    var PLOT_H = H - PAD_B - PAD_T;
    var W = parseFloat(svg.dataset.w);

    function niceMax(v, steps) {
        steps = steps || 4;
        if (v <= 0) return steps;
        var mag = Math.pow(10, Math.floor(Math.log10(v)));
        var mags = [1, 1.5, 2, 2.5, 3, 4, 5, 7.5, 10];
        for (var i = 0; i < mags.length; i++) {
            if (mag * mags[i] >= v) return mag * mags[i];
        }
        return mag * 10;
    }

    function recalcHourly() {
        var attemptsGroup = svg.querySelector('.hr-series-group[data-series="attempts"]');
        var answeredGroup = svg.querySelector('.hr-series-group[data-series="answered"]');
        var accountsGroup = svg.querySelector('.hr-series-group[data-series="accounts"]');
        if (!attemptsGroup || !answeredGroup || !accountsGroup) return;

        var PAD_L = parseFloat(svg.dataset.padL) || 0;

        var attemptsVisible = attemptsGroup.dataset.visible === 'true';
        var answeredVisible = answeredGroup.dataset.visible === 'true';
        var accountsVisible = accountsGroup.dataset.visible === 'true';

        // "attempts"/"answered" comparten eje de conteo, igual que en
        // Call Traffic — "accounts" tiene su propio eje y se reescala
        // siempre a su propio máximo, independiente de los otros dos.
        var countVals = [];
        if (attemptsVisible) attemptsGroup.querySelectorAll('.h-tot').forEach(function(r) { countVals.push(parseFloat(r.dataset.raw)); });
        if (answeredVisible) answeredGroup.querySelectorAll('.h-ans').forEach(function(r) { countVals.push(parseFloat(r.dataset.raw)); });

        if (countVals.length > 0) {
            var yMax = niceMax(Math.max.apply(null, countVals));
            var gridGroup = document.getElementById('hr-gridlines');
            gridGroup.innerHTML = '';
            for (var i = 0; i <= 4; i++) {
                var y = PAD_T + PLOT_H - (PLOT_H * (yMax * i / 4) / yMax);
                var line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                line.setAttribute('class', 'grid');
                line.setAttribute('x1', PAD_L); line.setAttribute('y1', y);
                line.setAttribute('x2', W); line.setAttribute('y2', y);
                gridGroup.appendChild(line);

                var lbl = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                lbl.setAttribute('class', 'h-axis-lbl mono');
                lbl.setAttribute('x', PAD_L - 6); lbl.setAttribute('y', y + 3);
                lbl.setAttribute('text-anchor', 'end'); lbl.setAttribute('font-size', '9');
                lbl.textContent = Math.round(yMax * i / 4);
                gridGroup.appendChild(lbl);
            }
            attemptsGroup.querySelectorAll('.h-tot').forEach(function(r) {
                var v = parseFloat(r.dataset.raw);
                var h = PLOT_H * Math.min(v, yMax) / yMax;
                r.setAttribute('height', h);
                r.setAttribute('y', PAD_T + PLOT_H - h);
            });
            answeredGroup.querySelectorAll('.h-ans').forEach(function(r) {
                var v = parseFloat(r.dataset.raw);
                var h = PLOT_H * Math.min(v, yMax) / yMax;
                r.setAttribute('height', h);
                r.setAttribute('y', PAD_T + PLOT_H - h);
            });
            answeredGroup.querySelectorAll('.hr-pct-label').forEach(function(lbl) {
                var cx = parseFloat(lbl.getAttribute('x'));
                var match = null;
                answeredGroup.querySelectorAll('.h-ans').forEach(function(r) {
                    if (Math.abs(parseFloat(r.dataset.cx) - cx) < 0.5) match = r;
                });
                if (match) lbl.setAttribute('y', parseFloat(match.getAttribute('y')) - 4);
            });
        }

        // "accounts" siempre a su propia escala máxima — no depende de qué
        // más esté visible, así que se recalcula igual, siempre.
        var accountVals = [];
        accountsGroup.querySelectorAll('.h-accounts').forEach(function(r) { accountVals.push(parseFloat(r.dataset.raw)); });
        if (accountVals.length > 0) {
            var aMax = niceMax(Math.max.apply(null, accountVals));
            accountsGroup.querySelectorAll('.h-accounts').forEach(function(r) {
                var v = parseFloat(r.dataset.raw);
                var h = PLOT_H * Math.min(v, aMax) / aMax;
                r.setAttribute('height', h);
                r.setAttribute('y', PAD_T + PLOT_H - h);
            });
        }

        attemptsGroup.style.opacity = attemptsVisible ? '1' : '0';
        answeredGroup.style.opacity = answeredVisible ? '1' : '0';
        accountsGroup.style.opacity = accountsVisible ? '1' : '0';
    }

    window.toggleHourly = function(seriesName, btn) {
        btn.classList.toggle('active');
        var isActive = btn.classList.contains('active');
        var group = svg.querySelector('.hr-series-group[data-series="' + seriesName + '"]');
        if (group) group.dataset.visible = isActive ? 'true' : 'false';
        recalcHourly();
    };

    recalcHourly();
})();
</script>
