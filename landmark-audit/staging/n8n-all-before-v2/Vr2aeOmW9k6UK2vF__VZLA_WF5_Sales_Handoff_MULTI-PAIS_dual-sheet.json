    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const r = item.json || {};\n  const status        = String(r.status         || '').toUpperCase();\n  const interested    = String(r.interested     || '').toUpperCase() === 'TRUE';\n  const accountOpened = String(r.account_opened || '').toUpperCase();\n  let action = 'SKIP';\n  let next_action = '';\n\n  if (accountOpened === 'TRUE' && status !== 'CONVERTED') {\n    action = 'CONVERTED';\n    next_action = 'Welcome onboarding + first deposit follow-up';\n  } else if ((interested || accountOpened === 'PENDING') && !['SALES_HANDOFF', 'CONVERTED'].includes(status)) {\n    action = 'HANDOFF';\n    next_action = accountOpened === 'PENDING'\n      ? 'Call advisor: confirm credentials received + assist first deposit (min $25 USD)'\n      : 'Call advisor: nurture & confirm account opening';\n  }\n\n  if (action !== 'SKIP') out.push({ json: { ...r, _action: action, next_action } });\n}\nreturn out;"
      },
