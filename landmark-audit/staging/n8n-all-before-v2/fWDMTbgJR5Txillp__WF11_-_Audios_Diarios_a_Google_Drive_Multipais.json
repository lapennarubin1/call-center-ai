      "id": "a1da08f4-8bab-4189-9f39-0a1fd75bc8f1",
      "name": "Diario 02:00 IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        7792,
        1936
      ]
    },
    {
      "parameters": {
        "jsCode": "const KEY_INDIA = 'sk_79048a9776812db4416e5c690d0c047132d565fee7d43acd';\nconst KEY_NEPAL = 'sk_79048a9776812db4416e5c690d0c047132d565fee7d43acd';\nconst KEY_VZLA  = 'sk_79048a9776812db4416e5c690d0c047132d565fee7d43acd';\n\nconst AGENTS = [\n  { \n    agent_id: 'agent_5701kramx550e3qs2tm11661b48p', \n    key: KEY_INDIA, \n    country: 'india' \n  },\n\n  { \n    agent_id: 'agent_7601m209ntj3fyrbg0dcq6w507yq', \n    key: KEY_NEPAL, \n    country: 'nepal' \n  },\n\n  { \n    agent_id: 'agent_5801kt2n54gne8s8dwgb03sbwf02', \n    key: KEY_VZLA,  \n    country: 'venezuela' \n  }, // tambien colombia (mismo agente)\n\n  { \n    agent_id: 'agent_5801kt2n54gne8s8dwgb03sbwf02', \n    key: KEY_VZLA,  \n    country: 'mexico' \n  }\n];\n\n// Día anterior completo en horario IST (UTC+5:30) — se mantiene IST como referencia\n// de \"día calendario\" para todos los países por simplicidad operativa (un solo corte diario)\nconst nowIst = new Date(Date.now() + 19800*1000);\n\nconst ayer = new Date(nowIst);\nayer.setUTCDate(ayer.getUTCDate()-1);\n\nconst dia = ayer.toISOString().slice(0,10);\n\nconst desde =\n  Math.floor(\n    new Date(dia+'T00:00:00Z').getTime()/1000\n  ) - 19800;\n\nconst hasta = desde + 86400;\n\nconsole.log(\n  `🎧 Audios del ${dia} IST | ${desde} → ${hasta}`\n);\n\nconst base = 'https://api.elevenlabs.io/v1/convai/conversations';\n\nlet todas = [];\n\nfor (const ag of AGENTS) {\n\n  const H = {\n    'xi-api-key': ag.key\n  };\n\n  let cursor = '';\n  let p = 0;\n\n  do {\n\n    let u =\n      `${base}?page_size=100` +\n      `&call_start_after_unix=${desde}` +\n      `&call_start_before_unix=${hasta}` +\n      `&agent_id=${encodeURIComponent(ag.agent_id)}`;\n\n    if (cursor) {\n      u += `&cursor=${encodeURIComponent(cursor)}`;\n    }\n\n    const r =\n      await this.helpers.httpRequest({\n        method:'GET',\n        url:u,\n        headers:H,\n        json:true,\n        timeout:30000\n      });\n\n    const convos =\n      (r.conversations || []).map(c => ({\n        ...c,\n        _agent_key: ag.key,\n        _agent_country: ag.country\n      }));\n\n    todas = todas.concat(convos);\n\n    cursor =\n      r.has_more\n        ? (r.next_cursor || '')\n        : '';\n\n    p++;\n\n  } while (cursor && p < 20);\n}\n\nif (!todas.length) {\n  console.log('Sin llamadas ayer');\n  return [];\n}\n\n// Traer detalle solo de las que tienen audio (duración > 0)\nconst conAudio =\n  todas.filter(\n    c => Number(c.call_duration_secs || 0) > 0\n  );\n\nconsole.log(\n  `📞 ${todas.length} llamadas | ${conAudio.length} con audio`\n);\n\nconst out = [];\n\nfor (const c of conAudio) {\n\n  try {\n\n    const H = {\n      'xi-api-key': c._agent_key\n    };\n\n    const d =\n      await this.helpers.httpRequest({\n        method:'GET',\n        url:`${base}/${c.conversation_id}`,\n        headers:H,\n        json:true,\n        timeout:30000\n      });\n\n    out.push({\n      json: {\n        ...d,\n        _dia: dia,\n        _agent_key: c._agent_key,\n        _agent_country: c._agent_country\n      }\n    });\n\n  } catch(e) {\n\n    console.warn(\n      'detalle falló ' + c.conversation_id\n    );\n\n  }\n\n  await new Promise(\n    r => setTimeout(r,120)\n  );\n}\n\nreturn out;"
      },
      "id": "6820d429-2370-4529-9a45-fe6a643205a9",
      "name": "Listar Llamadas de Ayer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8032,
        1824
      ]
    },
    {
      "parameters": {
        "jsCode": "// ═══ Metadata y nombre de archivo para cada audio ═══\nconst items = $input.all();\nconst out = [];\n\nfor (const it of items) {\n  const c = it.json;\n  const d = c.data || c;\n\n  const convId = String(d.conversation_id || '');\n  if (!convId) continue;\n\n  const ts = Number(\n    d.metadata?.start_time_unix_secs ||\n    c.start_time_unix_secs ||\n    0\n  );\n\n  if (!ts) continue;\n\n  // Carpeta = día calendario IST\n  const carpeta = new Date(\n    (ts + 19800) * 1000\n  ).toISOString().slice(0, 10);\n\n  const hora = new Date(\n    (ts + 19800) * 1000\n  )\n    .toISOString()\n    .slice(11, 16)\n    .replace(':', '');\n\n  const dyn =\n    d.conversation_initiation_client_data?.dynamic_variables ||\n    {};\n\n  const leadId =\n    String(dyn.lead_id || '').trim();\n\n  const phone =\n    String(\n      dyn.phone ||\n      d.metadata?.phone_call?.external_number ||\n      ''\n    )\n    .replace(/[^0-9]/g, '');\n\n  const dur =\n    Number(\n      d.metadata?.call_duration_secs ||\n      0\n    );\n\n  const success =\n    String(\n      d.analysis?.call_successful ||\n      ''\n    ).toLowerCase();\n\n  const interest =\n    String(\n      d.analysis?.data_collection_results?.user_interest?.value ||\n      ''\n    ).toLowerCase();\n\n  // Sanitizar: sin espacios, barras, ni caracteres raros\n  const safe = (s) =>\n    String(s).replace(\n      /[^a-zA-Z0-9_+-]/g,\n      ''\n    );\n\n  // Nombre: leadID_telefono_hora_resultado_convid.mp3\n  let etiqueta = 'otro';\n\n  if (dur === 0) {\n    etiqueta = 'noanswer';\n  }\n  else if (success === 'failure') {\n    etiqueta = 'failed';\n  }\n  else if (\n    ['interested', 'true', 'yes'].includes(interest)\n  ) {\n    etiqueta = 'INTERESADO';\n  }\n  else {\n    etiqueta = 'completada';\n  }\n\n  const idParte =\n    leadId\n      ? `lead${safe(leadId)}`\n      : (\n          phone\n            ? `tel${safe(phone)}`\n            : 'sinid'\n        );\n\n  const nombre =\n    `${idParte}_` +\n    `${safe(phone).slice(-10) || 'nophone'}_` +\n    `${hora}_` +\n    `${etiqueta}_` +\n    `${safe(convId).slice(-8)}.mp3`;\n\n  const country =\n    String(\n      c._agent_country ||\n      d.country ||\n      ''\n    )\n    .trim()\n    .toLowerCase();\n\n  const apiKey =\n    c._agent_key ||\n    '';\n\n  out.push({\n    json: {\n      conversation_id: convId,\n      country: country,\n      api_key: apiKey,\n      lead_id: leadId || null,\n      phone: phone || null,\n      carpeta_dia: carpeta,\n      nombre_archivo: nombre,\n      duracion_secs: dur,\n      tiene_audio: dur > 0\n    }\n  });\n}\n\nconsole.log(\n  `🎧 ${out.length} audios a procesar | ` +\n  `${out.filter(o => o.json.tiene_audio).length} con contenido`\n);\n\nreturn out;"
      },
