        "jsCode": "// ═══ Filtrar audios ya registrados (idempotencia entre re-ejecuciones) ═══\nconst candidatos = $('Solo con audio1').all().map(i => i.json);\nconst existentes  = $input.all().map(i => i.json);\n\nconst yaSubidos = new Set(\n  existentes.map(r => String(r.conversation_id || '').trim()).filter(Boolean)\n);\n\nconst out = candidatos.filter(c => !yaSubidos.has(String(c.conversation_id || '').trim()));\n\nconsole.log(`🔁 Dedupe: ${candidatos.length} candidatos | ${yaSubidos.size} ya en sheet | ${out.length} nuevos a subir`);\nreturn out.map(j => ({ json: j }));\n"
