    {
      "parameters": {
        "jsCode": "// Classify the HTTP response the same way WF2 does\nconst resp = $input.first().json || {};\nconst lead = $('Loop One-by-One').item.json;\nconst statusCode = resp.statusCode || resp.status || (resp.headers ? 200 : null);\nconst body = resp.body || resp;\nconst conversationId = body.conversation_id || body.conversationId || body.call_sid || body.callSid || '';\n\nlet status, last_call_status, notes;\nif (statusCode && statusCode >= 200 && statusCode < 300 && conversationId) {\n  status = 'CALL_IN_PROGRESS';\n  last_call_status = 'FOLLOWUP_INITIATED';\n  notes = 'Follow-up dial sent: ' + conversationId;\n} else if (statusCode && statusCode >= 400) {\n  status = 'API_ERROR';\n  last_call_status = 'HTTP_' + statusCode;\n  notes = 'ElevenLabs error: ' + JSON.stringify(body).slice(0, 300);\n} else {\n  status = 'DIAL_FAILED';\n  last_call_status = 'NO_CONVERSATION_ID';\n  notes = 'Unexpected response: ' + JSON.stringify(body).slice(0, 300);\n}\n\nreturn [{ json: {\n  lead_id: lead.lead_id,\n  country: lead.country,\n  elevenlabs_call_id: conversationId,\n  status,\n  last_call_status,\n  notes,\n  call_attempts: Number(lead.call_attempts || 0) + 1,\n  last_call_time: new Date().toISOString()\n}}];"
      },
