      "parameters": {
        "jsCode": "const AGENT_ROUTING = {\n  'venezuela': {\n    agent_id: 'agent_5801kt2n54gne8s8dwgb03sbwf02',\n    agent_phone_number_id: 'phnum_3801kvb0m1wqfjh8qqcsh24gfarj',\n    language: 'es',\n    endpoint: 'twilio'\n  },\n  'mexico': {\n    agent_id: 'agent_9301ktxas162fypr684x98x2gcrn',\n    agent_phone_number_id: 'phnum_7801kyktmabxembteqce884tanb6',\n    language: 'es',\n    endpoint: 'sip-trunk'\n  },\n  'colombia': {\n    agent_id: 'agent_5801kt2n54gne8s8dwgb03sbwf02', // mismo agente de Venezuela\n    agent_phone_number_id: 'phnum_3801kvb0m1wqfjh8qqcsh24gfarj', // <-- REEMPLAZAR con el ID real\n    language: 'es',\n    endpoint: 'twilio'\n  },\n  'default': {\n    agent_id: 'agent_5801kt2n54gne8s8dwgb03sbwf02',\n    agent_phone_number_id: 'phnum_3801kvb0m1wqfjh8qqcsh24gfarj',\n    language: 'es',\n    endpoint: 'twilio'\n  }\n};\nfunction resolveAgent(country) {\n  return AGENT_ROUTING[country.toLowerCase()] || AGENT_ROUTING['default'];\n}\n\nconst r = { ...($input.first().json || {}) };\nconst phoneStr = String(r.phone || '');\nlet country = String(r.country || '').trim().toLowerCase();\nif (!country || country.length < 2) {\n  if (phoneStr.startsWith('+58'))      country = 'venezuela';\n  else if (phoneStr.startsWith('+57')) country = 'colombia';\n  else if (phoneStr.startsWith('+52')) country = 'mexico';\n  else if (phoneStr.startsWith('+1'))  country = 'usa';\n  else if (phoneStr.startsWith('+34')) country = 'spain';\n  else country = 'venezuela';\n}\nr.country = country;\nconst _agent = resolveAgent(country);\nr.agent_id = _agent.agent_id;\nr.agent_phone_number_id = _agent.agent_phone_number_id;\nr.language = _agent.language;\nr.endpoint = _agent.endpoint;\nreturn [{ json: r }];"
      },
