        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"agent_id\": \"{{ $json.agent_id }}\",\n  \"agent_phone_number_id\": \"{{ $json.agent_phone_number_id }}\",\n  \"to_number\": \"{{ $json.phone }}\",\n  \"conversation_initiation_client_data\": {\n    \"dynamic_variables\": {\n      \"lead_id\": \"{{ $json.lead_id }}\",\n      \"full_name\": \"{{ $json.full_name }}\",\n      \"country\": \"{{ $json.country }}\",\n      \"language\": \"{{ $json.language }}\",\n      \"is_followup\": \"true\",\n      \"prior_summary\": \"{{ String($json.conversation_summary || '').replace(/\\\"/g, ' ').slice(0, 400) }}\"\n    },\n    \"agent\": {\n      \"prompt\": {\n        \"prompt\": \"Modo follow-up: Este es el segundo contacto. Manten un tono amable y respetuoso. El usuario solicito una llamada de vuelta. Sin presion, pregunta si esta disponible para hablar ahora.\"\n      }\n    }\n  },\n  \"conversation_config_override\": {\n    \"agent\": {\n      \"post_call_webhook_url\": \"https://landmarket-n8n.dhsoig.easypanel.host/webhook/elevenlabs-postcall-webhook-vzla\"\n    }\n  }\n}",
