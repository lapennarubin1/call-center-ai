    {
      "parameters": {
        "amount": 1
      },
      "id": "071989ff-d752-4ff0-8437-080ba72b67cb",
      "name": "Esperar 1s (cuota)1",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        704,
        192
      ],
      "webhookId": "96a75119-91f3-448f-bf08-5c4beeab55be"
    },
    {
      "parameters": {
        "jsCode": "// ═══ Agregado diario final: lee el acumulado del static data ═══\n// Escribe directamente con los nombres de columna reales del tab 'report_daily'\nconst st = $getWorkflowStaticData('global');\nconst rows = st.acumulado || [];\nconsole.log(`📊 Agregando ${rows.length} conversaciones acumuladas`);\n\nconst byDay = new Map();\nfor (const r of rows) {\n  const day = r.fecha;\n  if (!day) continue;\n  if (!byDay.has(day)) byDay.set(day, {\n    date: day, total: 0, interested: 0, not_interested: 0, no_answer: 0, voicemail: 0,\n    technical_failures: 0, callbacks: 0, accounts: 0, dur_total: 0, con_dur: 0, msgs: 0\n  });\n  const d = byDay.get(day);\n  d.total++;\n  d.msgs += Number(r.messages || 0);\n  if (r.duration_secs > 0) { d.dur_total += r.duration_secs; d.con_dur++; }\n\n  const interest = String(r.interesado || '').toLowerCase();\n  const cb        = String(r.callback || '').toLowerCase();\n  const acct      = String(r.cuenta_pedida || '').toLowerCase();\n  const succ      = String(r.call_successful || '').toLowerCase();\n  const term      = String(r.termination || '').toLowerCase();\n  const isVoicemail = term.includes('voicemail') ||\n    (r.duration_secs > 0 && r.duration_secs < 8 && succ !== 'success');\n\n  if (r.duration_secs === 0)                            d.no_answer++;\n  else if (succ === 'failure')                           d.technical_failures++;\n  else if (isVoicemail)                                { d.voicemail++; d.no_answer++; }\n  else if (['interested','true','yes'].includes(interest)) d.interested++;\n  else if (['true','yes'].includes(cb))                  d.callbacks++;\n  else                                                    d.not_interested++;\n\n  if (['yes','true'].includes(acct)) d.accounts++;\n}\n\nconst out = [...byDay.values()].sort((a,b)=>a.date.localeCompare(b.date)).map(r => ({ json: {\n  date: r.date,\n  total_calls: r.total,\n  interested: r.interested,\n  not_interested: r.not_interested,\n  no_answer: r.no_answer,\n  voicemail: r.voicemail,\n  technical_failures: r.technical_failures,\n  callbacks_requested: r.callbacks,\n  accounts_requested: r.accounts,\n  contacted: r.interested + r.not_interested + r.callbacks,\n  average_duration_sec: r.con_dur ? Math.round(r.dur_total / r.con_dur) : 0,\n  total_duration_min: Math.round(r.dur_total / 60),\n  average_messages: r.total ? Math.round(r.msgs / r.total) : 0,\n  contact_rate_pct: r.total ? Number(((r.interested+r.not_interested+r.callbacks)/r.total*100).toFixed(1)) : 0,\n  interest_rate_pct: (r.interested+r.not_interested+r.callbacks)\n    ? Number((r.interested/(r.interested+r.not_interested+r.callbacks)*100).toFixed(1)) : 0,\n  generated_at: new Date().toISOString()\n}}));\n\nst.acumulado = []; // limpiar para la próxima corrida\nreturn out;\n"
      },
