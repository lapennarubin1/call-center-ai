    {
      "parameters": {
        "jsCode": "\n// Solo LISTA — rápido, sin detalle por conversación. Nunca se acerca al límite de 300s.\nconst KEY='86811e58db57a9cd5a1bdf87608bb2905d48b873e9b17e9b31742423c05aa968', AGENT='agent_5701kramx550e3qs2tm11661b48p';\nconst DIAS = Number($json.dias_atras || 7);\nconst after = Math.floor(Date.now()/1000) - (DIAS*86400);\nconst H={'xi-api-key':KEY};\nconst base='https://api.elevenlabs.io/v1/convai/conversations';\n\nlet cursor='', todas=[], p=0;\ndo{\n  let u=`${base}?page_size=100&summary_mode=include&call_start_after_unix=${after}&agent_id=${encodeURIComponent(AGENT)}`;\n  if(cursor) u+=`&cursor=${encodeURIComponent(cursor)}`;\n  const r=await this.helpers.httpRequest({method:'GET',url:u,headers:H,json:true,timeout:30000});\n  todas=todas.concat(r.conversations||[]);\n  cursor=r.has_more?(r.next_cursor||''):''; p++;\n  console.log(`📄 Página ${p}: total ${todas.length}`);\n}while(cursor && p<30);\n\nconsole.log(`✅ ${todas.length} conversaciones listadas | el detalle se trae 1x1 en el loop`);\nreturn todas.map(c => ({ json: c }));\n"
      },
      "id": "4d8ad3b4-96e5-495b-bfc0-e9436c5d0d63",
      "name": "Listar Conversaciones (solo lista)1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        208
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "e9f92a49-dc5e-4ff9-9983-2544200672ed",
      "name": "Loop Conversaciones (1x1)1",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -288,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Corre UNA vez por cada item que entrega el loop — rápido, nunca se acerca a 300s.\nconst KEY='86811e58db57a9cd5a1bdf87608bb2905d48b873e9b17e9b31742423c05aa968';\nconst H={'xi-api-key':KEY};\nconst c = $json;\ntry {\n  const det = await this.helpers.httpRequest({\n    method:'GET', url:`https://api.elevenlabs.io/v1/convai/conversations/${c.conversation_id}`,\n    headers:H, json:true, timeout:20000\n  });\n  return [{ json: { ...c, detail: det } }];\n} catch(e) {\n  console.warn('⚠️ Detalle falló: ' + c.conversation_id);\n  return [{ json: { ...c, detail: null } }];\n}\n"
      },
      "id": "1c2a2ec9-deb3-4529-a43f-ef72bcb50c12",
      "name": "Traer Detalle1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "// ═══ Formatea un lote de conversaciones ya con detalle adjunto ═══\nconst IST = 19800;\nconst mmss = s => `${Math.floor(s/60)}:${String(s%60).padStart(2,'0')}`;\n\nconst items = $input.all().map(i => i.json);\nconst rows = [];\n\nfor (const d of items) {\n  const det = d.detail || {};\n  const dyn = det.conversation_initiation_client_data?.dynamic_variables || {};\n  const raw = det.analysis?.data_collection_results || {};\n  const dc = {};\n  for (const k of Object.keys(raw)) dc[k] = raw[k]?.value ?? '';\n\n  const ts  = Number(d.start_time_unix_secs || 0);\n  const iso = ts ? new Date((ts + IST) * 1000).toISOString() : '';\n  const dur = Number(d.call_duration_secs || 0);\n\n  rows.push({\n    fecha: iso.slice(0, 10),\n    hora_ist: iso.slice(11, 16),\n    branch: d.agent_name || d.branch_id || '',\n    title: d.call_summary_title || '',\n    duration_secs: dur,\n    duration_mmss: mmss(dur),\n    messages: d.message_count || 0,\n    status: d.status || '',\n    call_successful: d.call_successful || '',\n    receiver_number: det.metadata?.phone_call?.external_number || dyn.phone || '',\n    lead_id: dyn.lead_id || '',\n    idioma: d.main_language || '',\n    termination: d.termination_reason || '',\n    interesado: String(dc.user_interest || ''),\n    callback: String(dc.callback_requested || ''),\n    cuenta_pedida: String(dc.account_requested || ''),\n    resumen: String(d.transcript_summary || '').slice(0, 400),\n    conversation_id: d.conversation_id\n  });\n}\n\n// Acumular para el agregado diario final (se lee cuando el loop termina)\nconst st = $getWorkflowStaticData('global');\nst.acumulado = (st.acumulado || []).concat(rows);\nconsole.log(`📦 Lote formateado: ${rows.length} filas | acumulado total: ${st.acumulado.length}`);\nreturn rows.map(j => ({ json: j }));\n"
      },
