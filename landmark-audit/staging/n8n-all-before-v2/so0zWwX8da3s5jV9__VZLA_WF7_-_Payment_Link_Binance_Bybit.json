    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst ctx = $('Build Monetix Signed URL').first().json;\n\nlet shortUrl = '';\nif (typeof resp === 'string') shortUrl = resp;\nelse shortUrl = resp.data || resp.body || resp.text || '';\n\n// Fallback: si TinyURL falla o devuelve algo raro, usar el link original de Monetix\nif (!shortUrl || !shortUrl.startsWith('http')) shortUrl = ctx.checkout_url;\n\nreturn [{ json: { ...ctx, short_url: shortUrl } }];"
      },
