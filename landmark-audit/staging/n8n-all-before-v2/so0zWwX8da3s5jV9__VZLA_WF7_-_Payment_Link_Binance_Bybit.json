    {
      "parameters": {
        "jsCode": "// Build MonetiX (GTXpoint) hosted-payment-page request — Binance Pay / Bybit Pay only.\n// No email / trading-account collected via voice/SMS — synthesized placeholders used\n// (per instruction: don't add new required fields to the agent's tool call).\n// The signature itself is computed in the next node (Crypto / HMAC-SHA512).\nconst ctx = $input.first().json;\n\nconst METHODS = {\n  // TODO: Binance Pay limits are unconfirmed on project 164622 — per the handover\n  // doc this is a placeholder mirroring Bybit. Confirm with Monetix account manager.\n  binance: { code: 'unify_Binance_Pay', currency: 'USD', language: 'en' },\n  // KNOWN ISSUE (handover doc §11): Bybit renders a valid signed page but declines\n  // instantly with no QR shown — flagged as a gateway/account activation issue on\n  // project 164622, not a code bug. Escalate to Monetix with the payment_id if seen.\n  bybit:   { code: 'bybit',             currency: 'USD', language: 'en' },\n};\n\nconst m = METHODS[ctx.payment_method];\nif (!m) {\n  return [{ json: { ...ctx,\n    success: false,\n    reason: 'invalid payment_method for Monetix branch: ' + ctx.payment_method,\n    user_message: 'Lo siento, ese método de pago no está disponible.'\n  }}];\n}\n\nconst nameParts = String(ctx.full_name || 'Cliente').trim().split(/\\s+/);\nconst firstName = nameParts[0] || 'Cliente';\nconst lastName  = nameParts.slice(1).join(' ') || 'LandmarkMarkets';\n\n// TODO: move project_id / secret / host to n8n environment variables or a\n// credential instead of hardcoding — see the HMAC Sign node below for the secret.\nconst MONETIX_PROJECT_ID = 164622;\nconst FRONTEND_URL = 'https://deposit.lmtrader.net';\n\nconst params = {\n  project_id: MONETIX_PROJECT_ID,\n  payment_id: ctx.out_trade_no,\n  payment_amount: Math.round(Number(ctx.amount) * 100), // minor units\n  payment_currency: m.currency,\n  customer_id: ctx.lead_id,\n  account_customer_name: `${firstName} ${lastName}`.trim(),\n  customer_first_name: firstName,\n  customer_last_name: lastName,\n  // Placeholder — no real email is collected via SMS/voice in this flow.\n  customer_email: `${ctx.lead_id}@landmarkmarkets.com`,\n  force_payment_method: m.code,\n  payment_description: `Landmark Markets Deposit - ${ctx.full_name}`,\n  language_code: m.language,\n  merchant_success_url: `${FRONTEND_URL}/payment/success?payment_id=${ctx.out_trade_no}`,\n  merchant_fail_url: `${FRONTEND_URL}/payment/fail?payment_id=${ctx.out_trade_no}`,\n  merchant_return_url: `${FRONTEND_URL}/payment/return?payment_id=${ctx.out_trade_no}`,\n};\n\n// --- MonetiX signature-base builder ---\n// Flatten every value into \"path:value\" strings (nested objects/arrays expand\n// with ':' , arrays use zero-based indices, empty arrays skipped, booleans -> 1/0),\n// sort alphabetically, join with ';'. This mirrors server/monetix.js exactly.\nfunction flatten(value, prefix, out) {\n  if (Array.isArray(value)) {\n    if (value.length === 0) return;\n    value.forEach((item, index) => {\n      const path = prefix ? `${prefix}:${index}` : String(index);\n      flatten(item, path, out);\n    });\n    return;\n  }\n  if (value !== null && typeof value === 'object') {\n    for (const key of Object.keys(value)) {\n      const path = prefix ? `${prefix}:${key}` : String(key);\n      flatten(value[key], path, out);\n    }\n    return;\n  }\n  let normalized;\n  if (typeof value === 'boolean') normalized = value ? '1' : '0';\n  else if (value === null || value === undefined) normalized = '';\n  else normalized = String(value);\n  out.push(`${prefix}:${normalized}`);\n}\n\nconst parts = [];\nflatten(params, '', parts);\nparts.sort();\nconst signature_base = parts.join(';');\n\nreturn [{ json: { ...ctx, params, signature_base } }];"
      },
      "id": "4644f226-a8e9-4b2b-9f70-7aa5ba8edd81",
      "name": "Build Monetix Request",
