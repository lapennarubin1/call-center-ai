      "notes": "TODO: verify against your n8n version — Action=HMAC, Type=SHA512, Encoding=Base64. Also move the secret to an n8n credential/env var instead of hardcoding it here — this file will be shared/version-controlled."
    },
    {
      "parameters": {
        "jsCode": "// Take the HMAC-SHA512 signature from the Crypto node and assemble the final\n// signed GET link to MonetiX's hosted Payment Page.\n// NOTE: verify the exact output field name from the \"🔐 Monetix HMAC Sign\" node in\n// the n8n UI — this assumes it's \"data\" (the n8n Crypto node's default output\n// field). If your version names it differently (e.g. \"signature\"), change\n// `prev.data` below to match.\nconst prev = $input.first().json;\nconst ctx = $('Build Monetix Request').first().json;\n\nconst signature = prev.data;\nif (!signature) {\n  return [{ json: { ...ctx,\n    success: false,\n    reason: 'HMAC signing produced no output — check the Monetix HMAC Sign node output field name',\n    user_message: 'Lo siento, hubo un problema técnico generando el link de pago.'\n  }}];\n}\n\nconst finalParams = { ...ctx.params, signature };\nconst qs = Object.entries(finalParams)\n  .map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`)\n  .join('&');\n\n// TODO: move to an n8n environment variable instead of hardcoding.\nconst MONETIX_PP_HOST = 'paymentpage.txflux.com';\nconst checkout_url = `https://${MONETIX_PP_HOST}/payment?${qs}`;\n\nreturn [{ json: { ...ctx,\n  success: true,\n  checkout_url,\n  http_status: 200\n}}];"
      },
