    {
      "parameters": {
        "jsCode": "// HARD GUARD — LATAM / Multi-Gateway (Binance Pay | Bybit Pay)\nconst j = $input.first().json || {};\nconst lead_id   = String(j.lead_id || '').replace(/^=+/, '').trim();\nconst full_name = String(j.full_name || '').replace(/^=+/, '').trim();\nconst phone     = String(j.phone || '').replace(/^=+/, '').replace(/[^0-9]/g, '');\nconst currency  = 'USD';\nconst amountRaw = j.amount;\nconst amountNum = Number(String(amountRaw || '0').replace(/^=/, '').trim());\nconst riskConfirmed = j.risk_disclosure_confirmed === true || j.risk_disclosure_confirmed === 'true';\n\nconst ALLOWED_METHODS = ['binance', 'bybit'];\nconst payment_method = String(j.payment_method || '').replace(/^=+/, '').trim().toLowerCase();\n\nconst TWILIO_NUMBERS = ['917827796280', '16514170638'];\nlet whatsapp_phone = String(j.whatsapp_phone || '').replace(/^=+/, '').replace(/[^0-9]/g, '');\nif (!whatsapp_phone || TWILIO_NUMBERS.includes(whatsapp_phone)) {\n  whatsapp_phone = phone;\n}\nif (!whatsapp_phone.startsWith('+')) {\n  whatsapp_phone = '+' + whatsapp_phone;\n}\n\nconst errs = [];\nif (!lead_id) errs.push('missing lead_id');\nif (!phone) errs.push('missing phone');\nif (!Number.isFinite(amountNum) || amountNum < 25) errs.push('amount must be >= 25 USD');\nif (amountNum > 10000) errs.push('amount exceeds ceiling 10000 USD');\nif (!riskConfirmed) errs.push('risk_disclosure_confirmed must be true');\nif (!ALLOWED_METHODS.includes(payment_method)) errs.push('payment_method must be one of: binance, bybit');\n\nif (errs.length) {\n  return [{ json: {\n    success: false,\n    refused: true,\n    reason: errs.join('; '),\n    user_message: 'Lo siento, no puedo generar el link de pago. Razón: ' + errs.join(', ')\n  }}];\n}\n\nconst out_trade_no = 'LM_' + lead_id + '_' + Date.now();\nconst idempotency_key = 'pay_' + out_trade_no;\n\nreturn [{ json: {\n  ok: true,\n  lead_id, full_name, phone, whatsapp_phone, currency, payment_method,\n  amount: Math.floor(amountNum),\n  amount_cents: Math.floor(amountNum * 100),\n  out_trade_no, idempotency_key\n}}];"
      },
