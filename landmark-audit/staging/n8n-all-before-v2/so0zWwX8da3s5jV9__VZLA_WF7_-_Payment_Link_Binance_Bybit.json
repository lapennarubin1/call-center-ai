    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst clientPhone = String(b.phone || b.lead_id || '').replace(/^=+/, '').replace(/[^0-9]/g, '');\n\nlet whatsapp_phone = String(b.whatsapp_phone || '').replace(/^=+/, '').replace(/[^0-9]/g, '');\nif (!whatsapp_phone || !whatsapp_phone.startsWith('58')) {\n  whatsapp_phone = clientPhone;\n}\nif (!whatsapp_phone.startsWith('+')) {\n  whatsapp_phone = '+' + whatsapp_phone;\n}\n\nreturn [{ json: {\n  lead_id:                   String(b.lead_id || Date.now()).replace(/^=+/, '').trim(),\n  full_name:                 String(b.full_name || 'friend').replace(/^=+/, '').trim(),\n  phone:                     clientPhone,\n  whatsapp_phone:            whatsapp_phone,\n  currency:                  'USD',\n  amount:                    b.amount || 25,\n  risk_disclosure_confirmed: true,\n  payment_method:            String(b.payment_method || '').replace(/^=+/, '').trim().toLowerCase()\n}}];"
      },
