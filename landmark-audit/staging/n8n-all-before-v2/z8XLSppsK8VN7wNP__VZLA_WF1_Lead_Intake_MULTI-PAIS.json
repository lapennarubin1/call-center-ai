    {
      "parameters": {
        "jsCode": "// Pick rows that need validation (status empty or PENDING_VALIDATION)\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json || {};\n  const status = String(r.status || '').trim().toUpperCase();\n  if (status === '' || status === 'PENDING_VALIDATION') out.push({ json: r });\n}\nreturn out;"
      },
      "name": "Filter Pending",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        -192
      ],
      "id": "da8a0532-00b3-4d8c-9008-1604dab3c20a"
    },
    {
      "parameters": {
        "jsCode": "const all = $('Merge Leads1').all().map(i => i.json);\nconst pending = $input.all().map(i => i.json);\n\nconst seenIds    = new Map();\nconst seenPhones = new Map();\nfor (const row of all) {\n  if (row.lead_id) seenIds.set(String(row.lead_id).trim(), row);\n  if (row.phone)   seenPhones.set(String(row.phone).trim(), row);\n}\n\n// Prefijos por pais para normalizar E.164\nconst COUNTRY_PREFIX = {\n  'venezuela': '+58', 'vzla': '+58', 've': '+58',\n  'mexico':    '+52', 'mx':   '+52',\n  'colombia':  '+57', 'co':   '+57',\n  'usa':       '+1',  'us':   '+1',\n  'spain':     '+34', 'es':   '+34',\n  'india':     '+91', 'in':   '+91',\n};\n\nconst out = [];\nfor (const c of pending) {\n  const errors   = [];\n  const fullName = String(c.full_name || '').trim();\n  const country  = String(c.country   || '').trim();\n  const leadId   = String(c.lead_id   || '').trim();\n\n  // Normalizar idioma: LATAM = es, India = hi, default es\n  let language = String(c.language || '').trim().toLowerCase();\n  const countryLow = country.toLowerCase();\n  if (!language || language === 'hi') {\n    if (['india','in'].includes(countryLow)) language = 'hi';\n    else language = 'es';\n  }\n\n  // Normalizar telefono E.164\n  let phone = String(c.phone || '').replace(/[^0-9+]/g, '');\n  if (phone && !phone.startsWith('+')) {\n    const prefix = COUNTRY_PREFIX[countryLow];\n    if (prefix) {\n      // Quitar el codigo de pais si ya viene pegado al numero\n      const prefixDigits = prefix.replace('+', '');\n      if (phone.startsWith(prefixDigits) && phone.length > prefixDigits.length + 6) {\n        phone = '+' + phone;\n      } else {\n        phone = prefix + phone;\n      }\n    } else if (phone.length >= 8 && phone.length <= 15) {\n      phone = '+' + phone;\n    }\n  }\n\n  // Validaciones\n  if (!leadId)   errors.push('missing lead_id');\n  if (!fullName) errors.push('missing full_name');\n  if (!phone)    errors.push('missing phone');\n  if (!country)  errors.push('missing country');\n  if (phone && !/^\\+[1-9]\\d{7,14}$/.test(phone)) errors.push('invalid phone format: ' + phone);\n\n  // Dedup\n  const isActive = (s) => s && !['', 'PENDING_VALIDATION', 'INVALID_LEAD'].includes(String(s).toUpperCase());\n  const dupId = seenIds.get(leadId);\n  const dupPh = seenPhones.get(phone);\n  if (dupId && isActive(dupId.status) && String(dupId.row_number || '') !== String(c.row_number || '')) {\n    errors.push('duplicate lead_id');\n  } else if (dupPh && isActive(dupPh.status) && String(dupPh.row_number || '') !== String(c.row_number || '')) {\n    errors.push('duplicate phone');\n  }\n\n  const valid = errors.length === 0;\n  out.push({ json: {\n    lead_id:   leadId,\n    phone,\n    full_name: fullName,\n    country,\n    language,\n    _valid:    valid,\n    _errors:   errors.join('; '),\n    status:    valid ? 'READY_TO_CALL' : 'INVALID_LEAD',\n    notes:     valid ? 'Validated OK' : ('VALIDATION FAIL: ' + errors.join('; '))\n  }});\n}\nreturn out;"
      },
      "name": "Validate + Dedup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
