    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (!items.length) {\n  return [];\n}\n\n// El primer item tiene un array \"leads\" adentro\nconst allLeads = items[0].json.leads || [];\n\nconst out = allLeads\n  .filter(lead => lead.phone && !lead.doNotCall)\n  .map(lead => ({\n    json: {\n      lead_id: lead.id,\n      name: lead.name,\n      phone: lead.phone,\n      country: lead.country,\n      language: lead.language || 'unknown',\n      stage: lead.stage,\n      status: lead.status,\n      attempts: lead.attempts\n    }\n  }));\n\nconsole.log(`${out.length} leads listos`);\nreturn out;"
      },
      "id": "cd3c9046-ebb1-4e1b-8f07-689ed0988b09",
      "name": "⚙️ Combinar + Filtrar leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        112
      ]
    },
