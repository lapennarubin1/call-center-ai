              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "id": "9236e433-a67f-4786-b06c-528465ed9715",
      "name": "📌 PATCH status ATTEMPTING",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// Marca este item como listo para que WF2 lo recoja.\n// WF1 SOLO prepara la cola — NO llama, eso lo hace WF2.\nconst item = $input.item.json;\n\nconsole.log(`✅ Lead ${item.lead_id} (${item.name}, ${item.phone}) marcado ATTEMPTING — listo para WF2`);\n\nreturn {\n  json: {\n    lead_id: item.lead_id,\n    name: item.name,\n    phone: item.phone,\n    country: item.country,\n    language: item.language,\n    status: 'ready_for_wf2',\n    processed_at: new Date().toISOString()\n  }\n};\n"
      },
      "id": "ab402af0-40cb-4b2c-af1b-43916791e429",
      "name": "✅ Log resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// Login falló — no hay token, abortar ejecución con detalle claro.\nconst resp = $('🔐 Login LeadStudio').item.json;\nconsole.error('❌ WF1: Login a LeadStudio falló', JSON.stringify(resp));\nreturn [{\n  json: {\n    error: true,\n    message: 'LeadStudio auth failed — revisar LEADSTUDIO_EMAIL / LEADSTUDIO_PASSWORD',\n    response: resp\n  }\n}];\n"
      },
