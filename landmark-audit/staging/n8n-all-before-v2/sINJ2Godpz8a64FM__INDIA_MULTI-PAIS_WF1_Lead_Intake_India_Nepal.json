    },
    {
      "parameters": {
        "jsCode": "// Pick rows that need validation (status empty or PENDING_VALIDATION)\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json || {};\n  const status = String(r.status || '').trim().toUpperCase();\n  if (status === '' || status === 'PENDING_VALIDATION') out.push({ json: r });\n}\nreturn out;"
      },
      "id": "47caff23-b1cc-4637-883f-33c824150547",
      "name": "Filter Pending",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Validación compartida, pero dedup SEPARADO por pestaña/país.\n// India y Nepal nunca se mezclan para determinar duplicados.\nconst COUNTRY_CFG = {\n  india: {enabled:true, prefix:'+91', language:'hi', sheet:'leads'},\n  nepal: {enabled:true, prefix:'+977', language:'hi', sheet:'leads nepal'},\n  slot3: {enabled:false, prefix:'', language:'', sheet:'leads slot3'},\n  slot4: {enabled:false, prefix:'', language:'', sheet:'leads slot4'}\n};\n\nfunction normalizePhone(raw, cfg) {\n  let p=String(raw||'').replace(/[^0-9+]/g,'');\n  if (!p) return '';\n  if (p.startsWith('+')) return p;\n  const digits=cfg.prefix.replace('+','');\n  if (digits && p.startsWith(digits) && p.length > digits.length + 6) return '+'+p;\n  return cfg.prefix ? cfg.prefix+p : ('+'+p);\n}\n\nconst all = $('🔀 Merge India + Nepal').all().map(i=>i.json);\nconst pending = $input.all().map(i=>i.json);\nconst out=[];\n\nfor (const c of pending) {\n  const errors=[];\n  const country=String(c._source_country||c.country||'').trim().toLowerCase();\n  const cfg=COUNTRY_CFG[country];\n  const sourceSheet=String(c._source_sheet||cfg?.sheet||'').trim();\n\n  const leadId=String(c.lead_id||'').trim();\n  const fullName=String(c.full_name||'').trim();\n  const phone=cfg ? normalizePhone(c.phone,cfg) : String(c.phone||'').replace(/[^0-9+]/g,'');\n  const language=String(c.language||cfg?.language||'').trim().toLowerCase();\n\n  if (!leadId) errors.push('missing lead_id');\n  if (!c.phone) errors.push('missing phone');\n  if (!cfg) errors.push('unsupported country');\n  if (cfg && !cfg.enabled) errors.push('country disabled');\n  if (!sourceSheet) errors.push('missing source sheet');\n  if (phone && !/^\\+[1-9]\\d{7,14}$/.test(phone)) errors.push('invalid phone format');\n\n  // DEDUP solo dentro de la misma pestaña.\n  const peers = all.filter(r => String(r._source_sheet||'') === sourceSheet);\n  const isActive=s => s && !['','PENDING_VALIDATION','INVALID_LEAD'].includes(String(s).toUpperCase());\n  const sameRow = r => String(r.row_number||'') === String(c.row_number||'');\n  const dupId = peers.find(r => String(r.lead_id||'').trim()===leadId && !sameRow(r) && isActive(r.status));\n  const dupPhone = peers.find(r => {\n    const rp = cfg ? normalizePhone(r.phone,cfg) : String(r.phone||'').replace(/[^0-9+]/g,'');\n    return rp===phone && !sameRow(r) && isActive(r.status);\n  });\n  if (dupId) errors.push('duplicate lead_id in '+sourceSheet);\n  else if (dupPhone) errors.push('duplicate phone in '+sourceSheet);\n\n  const valid=errors.length===0;\n  out.push({json:{\n    lead_id:leadId,\n    phone,\n    full_name:fullName,\n    country,\n    language,\n    _source_country:country,\n    _source_sheet:sourceSheet,\n    _valid:valid,\n    _errors:errors.join('; '),\n    status:valid?'READY_TO_CALL':'INVALID_LEAD',\n    notes:valid?'Validated OK':('VALIDATION FAIL: '+errors.join('; '))\n  }});\n}\nreturn out;"
      },
