        "jsCode": "const out=[];\nfor (const item of $input.all()) {\n  const r={...(item.json||{})};\n  r.country='nepal';\n  // Nepal reutiliza temporalmente la configuración de idioma de India.\n  // Cambiar aquí cuando se defina un idioma/agente dedicado.\n  r.language=String(r.language||'hi').trim().toLowerCase();\n  r._source_country='nepal';\n  r._source_sheet='leads nepal';\n  out.push({json:r});\n}\nreturn out;"
