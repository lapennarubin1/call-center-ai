    {
      "parameters": {
        "jsCode": "// Pick rows that need validation (status empty or PENDING_VALIDATION)\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json || {};\n  const status = String(r.status || '').trim().toUpperCase();\n  if (status === '' || status === 'PENDING_VALIDATION') out.push({ json: r });\n}\nreturn out;"
      },
      "id": "5c56f38a-255f-4261-a0a3-066e9cef070b",
      "name": "Filter Pending1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// Validate + normalize each candidate lead.\n// Also captures the existing-rows snapshot for dedup in the next node.\nconst all = $('Read All Rows1').all().map(i => i.json);\nconst pending = $input.all().map(i => i.json);\n\nconst seenIds = new Map();\nconst seenPhones = new Map();\nfor (const row of all) {\n  if (row.lead_id) seenIds.set(String(row.lead_id).trim(), row);\n  if (row.phone)   seenPhones.set(String(row.phone).trim(), row);\n}\n\nconst out = [];\nfor (const c of pending) {\n  const errors = [];\n  const fullName = String(c.full_name || '').trim();\n  const country  = String(c.country   || '').trim();\n  const language = String(c.language  || 'hi').trim().toLowerCase();\n  const leadId   = String(c.lead_id   || '').trim();\n  let phone     = String(c.phone     || '').replace(/[^0-9+]/g, '');\n\n  if (!leadId)   errors.push('missing lead_id');\n  //if (!fullName) errors.push('missing full_name');\n  if (!phone)    errors.push('missing phone');\n  if (!country)  errors.push('missing country');\n  if (language !== 'hi') errors.push('language must be hi');\n\n  // E.164 normalization\n  if (phone && !phone.startsWith('+')) {\n    if (/^india$|^in$/i.test(country) && phone.length === 10) {\n      phone = '+91' + phone;\n    } else if (phone.length >= 10) {\n      phone = '+' + phone;\n    } else {\n      errors.push('invalid phone length');\n    }\n  }\n  if (phone && !/^\\+[1-9]\\d{7,14}$/.test(phone)) errors.push('invalid phone format');\n\n  // Dedup: same lead_id or phone already in an active state\n  const isActive = (s) => s && !['', 'PENDING_VALIDATION', 'INVALID_LEAD'].includes(String(s).toUpperCase());\n  const dupId = seenIds.get(leadId);\n  const dupPh = seenPhones.get(phone);\n  if (dupId && isActive(dupId.status) && String(dupId.row_number || '') !== String(c.row_number || '')) {\n    errors.push('duplicate lead_id');\n  } else if (dupPh && isActive(dupPh.status) && String(dupPh.row_number || '') !== String(c.row_number || '')) {\n    errors.push('duplicate phone');\n  }\n\n  const valid = errors.length === 0;\n  out.push({ json: {\n    lead_id: leadId,\n    phone, full_name: fullName, country, language,\n    _valid: valid,\n    _errors: errors.join('; '),\n    status: valid ? 'READY_TO_CALL' : 'INVALID_LEAD',\n    notes: valid ? 'Validated OK' : ('VALIDATION FAIL: ' + errors.join('; '))\n  }});\n}\nreturn out;"
      },
