    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst b = raw.body || raw;\n\n// OkPay sends flat form fields\nconst status     = String(b.status || b.trade_status || '').toUpperCase();\nconst money      = String(b.money || b.amount || '');\nconst outTradeNo = String(b.out_trade_no || '');\nconst transId    = String(b.transaction_id || b.transactionId || b.trade_no || '');\nconst attach     = String(b.attach || ''); // echoed lead_id\nconst phone      = String(b.phone || '').replace(/[^0-9]/g, '');\nconst mchId      = String(b.mchId || b.mch_id || '');\n\nconsole.log('📥 OkPay callback | status:', status, '| money:', money, '| out_trade_no:', outTradeNo, '| attach:', attach);\n\n// OkPay success statuses\nconst isPaid = status === 'SUCCESS' || status === 'PAID' || status === '1' || status === 'COMPLETED';\n\nif (!isPaid) {\n  console.log('⚠️ Payment not successful, status:', status);\n  return [{ json: { isPaid: false, status, outTradeNo, transId } }];\n}\n\n// Extract lead_id from attach or out_trade_no\nlet leadId = attach || outTradeNo;\n\nreturn [{ json: {\n  isPaid: true,\n  status,\n  money,\n  outTradeNo,\n  transId,\n  leadId,\n  phone,\n  mchId,\n  raw: b\n}}];"
      },
