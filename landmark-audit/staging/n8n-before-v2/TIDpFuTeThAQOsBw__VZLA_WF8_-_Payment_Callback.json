    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst b = raw.body || raw;\n\n// Stripe evento\nconst eventType = String(b.type || '');\nconst session = b.data?.object || {};\n\n// Detectar pago completado\nconst isPaid = eventType === 'checkout.session.completed' || \n               eventType === 'payment_intent.succeeded';\n\nif (!isPaid) {\n  return [{ json: { isPaid: false, eventType } }];\n}\n\nconst leadId    = String(session.metadata?.lead_id || '');\nconst outTradeNo = String(session.metadata?.out_trade_no || '');\nconst phone     = String(session.metadata?.phone || '').replace(/[^0-9]/g, '');\nconst money     = String((session.amount_total || session.amount_received || 0) / 100);\nconst currency  = String(session.currency || 'usd').toUpperCase();\nconst stripeId  = String(session.id || session.payment_intent || '');\n\nconsole.log('💳 Stripe callback | event:', eventType, '| lead:', leadId, '| amount:', money, currency);\n\nreturn [{ json: {\n  isPaid: true,\n  eventType,\n  leadId,\n  outTradeNo,\n  phone,\n  money,\n  currency,\n  stripeId,\n  raw: b\n}}];\n// secret verification whsec_0Ad3m55nS2LOJmdxkXsPz4YRi7pgTUnb"
      },
