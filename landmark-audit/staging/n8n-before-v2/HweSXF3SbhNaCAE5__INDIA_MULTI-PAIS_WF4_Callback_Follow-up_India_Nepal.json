      "name": "🔀 Merge India + Nepal",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        -144,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// ÚNICO filtro de callbacks: país + fecha + ventana local.\nconst CFG={\n  india:{enabled:true,tzOffsetMin:330,startHour:11,endHour:19,language:'hi',\n         agent_id:'agent_5701kramx550e3qs2tm11661b48p',\n         agent_phone_number_id:'phnum_3601kvqcgrbtf1n997j2dd8cz1qj',sheet:'leads'},\n  nepal:{enabled:true,tzOffsetMin:345,startHour:11,endHour:19,language:'hi',\n         agent_id:'agent_5701kramx550e3qs2tm11661b48p',\n         agent_phone_number_id:'phnum_3601kvqcgrbtf1n997j2dd8cz1qj',sheet:'leads nepal'},\n  slot3:{enabled:false,tzOffsetMin:0,startHour:0,endHour:24,language:'',agent_id:'',agent_phone_number_id:'',sheet:'leads slot3'},\n  slot4:{enabled:false,tzOffsetMin:0,startHour:0,endHour:24,language:'',agent_id:'',agent_phone_number_id:'',sheet:'leads slot4'}\n};\nconst now=Date.now(), out=[];\nfor (const item of $input.all()) {\n  const r={...(item.json||{})};\n  const country=String(r._source_country||r.country||'').trim().toLowerCase();\n  const cfg=CFG[country];\n  if (!cfg || !cfg.enabled) continue;\n  const status=String(r.status||'').trim().toUpperCase();\n  const cbReq=String(r.callback_requested||'').trim().toUpperCase()==='TRUE';\n  const cbMs=r.callback_date ? new Date(r.callback_date).getTime() : 0;\n  if (!cbReq || !cbMs || cbMs>now) continue;\n  if (['CONVERTED','DO_NOT_CALL','MAX_ATTEMPTS_REACHED'].includes(status)) continue;\n\n  const dt=new Date();\n  const utcMin=dt.getUTCHours()*60+dt.getUTCMinutes();\n  const localMin=(utcMin+cfg.tzOffsetMin+1440)%1440;\n  if (localMin < cfg.startHour*60 || localMin >= cfg.endHour*60) continue;\n\n  r.country=country;\n  r._source_country=country;\n  r._source_sheet=String(r._source_sheet||cfg.sheet);\n  r.language=String(r.language||cfg.language).trim().toLowerCase();\n  r._agent_id=cfg.agent_id;\n  r._agent_phone_number_id=cfg.agent_phone_number_id;\n  out.push({json:r});\n}\nreturn out;"
      },
