        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"agent_id\": \"{{ $json._agent_id }}\",\n  \"agent_phone_number_id\": \"{{ $json._agent_phone_number_id }}\",\n  \"to_number\": \"{{ $json.phone }}\",\n  \"conversation_initiation_client_data\": {\n    \"conversation_config_override\": {\n      \"agent\": { \"language\": \"{{ $json.language }}\" }\n    },\n    \"dynamic_variables\": {\n      \"lead_id\": \"{{ $json.lead_id }}\",\n      \"full_name\": \"{{ $json.full_name }}\",\n      \"phone\": \"{{ $json.phone }}\",\n      \"country\": \"{{ $json.country }}\",\n      \"language\": \"{{ $json.language }}\",\n      \"_source_sheet\": \"{{ $json._source_sheet }}\",\n      \"is_followup\": \"true\",\n      \"call_attempts\": \"{{ Number($json.call_attempts || 0) + 1 }}\",\n      \"prior_summary\": \"{{ String($json.conversation_summary || '').replace(/\\\"/g, ' ').slice(0, 400) }}\"\n    }\n  }\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 20000
        }
