    {
      "parameters": {
        "jsCode": "// Toma la respuesta de /call-log del worker Stringee y arma INSERTs en lotes.\n// Cruza to_number contra panel_leads (por los últimos 10 dígitos) para sacar lead_id.\n// No depende de WF2 ni WF9 — es 100% independiente, lee directo del Call Log de Stringee.\nfunction esc(v) {\n  if (v === null || v === undefined || v === '') return 'NULL';\n  return \"'\" + String(v).replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"''\") + \"'\";\n}\nfunction escNum(v) {\n  const n = Number(v);\n  return Number.isFinite(n) ? n : 0;\n}\nfunction detectCountry(phone) {\n  const p = String(phone || '').replace(/[^0-9]/g, '');\n  if (p.startsWith('977')) return 'nepal';\n  if (p.startsWith('91'))  return 'india';\n  if (p.startsWith('52'))  return 'mexico';\n  return 'unknown';\n}\n\nconst data = $input.all()[0]?.json || {};\nconst calls = (data.data && data.data.calls) || [];\n\nif (!calls.length) {\n  console.log('Sin llamadas nuevas');\n  return [];\n}\n\nconst rows = calls.map(c => {\n  const toNumber = String(c.to_number || '').replace(/[^0-9]/g, '');\n  return {\n    call_id: String(c.id || ''),\n    phone: toNumber,\n    country: detectCountry(toNumber),\n    answered: Number(c.answer_time) > 0 ? 1 : 0,\n    duration_secs: Number(c.answer_duration || 0),\n    start_time: Number(c.start_time || 0),\n    answer_time: Number(c.answer_time || 0),\n    stop_time: Number(c.stop_time || 0)\n  };\n}).filter(r => r.call_id);\n\nconst BATCH = 200;\nconst out = [];\nfor (let i = 0; i < rows.length; i += BATCH) {\n  const chunk = rows.slice(i, i + BATCH);\n  const values = chunk.map(r => {\n    const last10 = r.phone.slice(-10);\n    const leadSub = last10\n      ? `(SELECT lead_id FROM panel_leads WHERE RIGHT(phone,10)=${esc(last10)} LIMIT 1)`\n      : 'NULL';\n    return '(' + [\n      esc(r.call_id), leadSub, esc(r.phone), esc(r.country),\n      escNum(r.answered), escNum(r.duration_secs),\n      escNum(r.start_time), escNum(r.answer_time), escNum(r.stop_time)\n    ].join(',') + ')';\n  }).join(',\\n');\n\n  const sql = `INSERT INTO stringee_calls\n    (call_id, lead_id, phone, country, answered, duration_secs, start_time, answer_time, stop_time)\n    VALUES\n${values}\n    ON DUPLICATE KEY UPDATE\n      lead_id=VALUES(lead_id), country=VALUES(country), answered=VALUES(answered),\n      duration_secs=VALUES(duration_secs), answer_time=VALUES(answer_time), stop_time=VALUES(stop_time);`;\n\n  out.push({ json: { sql, batch_size: chunk.length } });\n}\n\nconsole.log('Stringee: ' + rows.length + ' llamadas -> ' + out.length + ' lote(s)');\nreturn out;\n"
      },
