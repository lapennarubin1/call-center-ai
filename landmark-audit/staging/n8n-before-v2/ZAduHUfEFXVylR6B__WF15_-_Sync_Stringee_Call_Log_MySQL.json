    {
      "parameters": {
        "jsCode": "// Cada fila que llega acá es una llamada de Stringee NO contestada,\n// con lead_id ya resuelto (viene de la query MySQL previa) y todavía\n// sin marcar como sincronizada al Sheet (sheet_synced=0).\n// Prepara los campos para \"Update Lead in Sheet\" — status=DIAL_FAILED\n// deja que el cooldown de 5min que YA tiene WF2 (Normalize & Select1)\n// la reintente solo, sin tocar WF2.\nconst items = $input.all();\nconst out = [];\n\nfor (const it of items) {\n  const r = it.json;\n  if (!r.lead_id) continue;\n  out.push({ json: {\n    lead_id: String(r.lead_id),\n    status: 'DIAL_FAILED',\n    last_call_status: 'STRINGEE_NO_ANSWER',\n    notes: '🔴 Stringee: no contestada (call_id ' + r.call_id + ')',\n    last_call_time: new Date().toISOString(),\n    _call_id: r.call_id\n  }});\n}\n\nconsole.log('Stringee no-contestadas a reportar al Sheet: ' + out.length);\nreturn out;\n"
      },
