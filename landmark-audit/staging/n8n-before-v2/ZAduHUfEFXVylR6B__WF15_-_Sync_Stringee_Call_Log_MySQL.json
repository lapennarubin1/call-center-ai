    {
      "parameters": {
        "jsCode": "// Después de actualizar el Sheet con éxito, marca estas llamadas como\n// sheet_synced=1 para no volver a procesarlas en la próxima corrida\n// (WF15 corre cada 10 min con ventana de 20 min — se solapan a propósito).\n// Referencia directa al nodo que armó los call_id — mismo patrón que\n// WF2/WF9 ya usan ($('NodeName').all()), sin depender de static data.\nconst items = $('⚙️ Preparar update Sheet').all();\nconst callIds = items.map(it => it.json._call_id).filter(Boolean);\n\nif (!callIds.length) {\n  console.log('Nada que marcar como sincronizado');\n  return [];\n}\n\nfunction esc(v) {\n  return \"'\" + String(v).replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"''\") + \"'\";\n}\nconst inList = callIds.map(esc).join(',');\nconst sql = `UPDATE stringee_calls SET sheet_synced=1 WHERE call_id IN (${inList});`;\nconsole.log('Marcando ' + callIds.length + ' llamada(s) como sheet_synced=1');\nreturn [{ json: { sql } }];\n"
      },
