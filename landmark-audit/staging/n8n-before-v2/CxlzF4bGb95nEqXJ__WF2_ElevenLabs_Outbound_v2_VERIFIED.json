      "parameters": {
        "jsCode": "// ═══ HORARIO DE LLAMADAS INDIA: 11:00–19:00 IST (UTC+5:30) ═══\n//const istMinutes = (new Date().getUTCHours() * 60 + new Date().getUTCMinutes() + 330) % 1440;\n//const IST_OPEN = 11 * 60, IST_CLOSE = 19 * 60;\n//if (istMinutes < IST_OPEN || istMinutes >= IST_CLOSE) {\n // const h = String(Math.floor(istMinutes / 60)).padStart(2, '0');\n//  const m = String(istMinutes % 60).padStart(2, '0');\n // console.log(`🌙 Fuera de horario India (${h}:${m} IST) — sin llamadas hasta las 11:00 IST`);\n//  return [];\n//}\n\nfunction toE164(raw) {\n  if (raw === undefined || raw === null) return '';\n  let p = String(raw).replace(/[^0-9+]/g, '');\n  if (!p) return '';\n  if (p.startsWith('+')) return p;\n  if (p.length >= 8 && p.length <= 15) return '+' + p;\n  return '';\n}\n\nconst SKIP_STATUSES = new Set([\n  'DO_NOT_CALL', 'CONVERTED', 'MAX_ATTEMPTS_REACHED',\n  'INTERESTED', 'NOT_INTERESTED', 'SALES_HANDOFF', 'ACCOUNT_OPENED',\n  'SUCCESSFUL', 'VOICEMAIL', 'FAILED', 'SCHEDULED'\n]);\n\nconst BATCH_SIZE = 4;              // = capacidad real del canal SIP\nconst RETRY_COOLDOWN_MIN = 5;      // reintento diferido, no en el mismo ciclo\nconst STUCK_TIMEOUT_MIN = 30;\n\nconst now = Date.now();\nconst attempts = [];\nconst skipped = [];\n\nfor (const item of $input.all()) {\n  const r = { ...(item.json || {}) };\n  const phone = toE164(r.phone);\n  let attemptsCount = Number(r.call_attempts || 0);\n  let status = String(r.status || '').trim().toUpperCase();\n\n  if (!phone) { skipped.push({ lead_id: r.lead_id, reason: `bad phone: '${r.phone}'` }); continue; }\n  if (!r.lead_id || String(r.lead_id).trim() === '') { skipped.push({ lead_id: 'EMPTY', reason: 'missing lead_id' }); continue; }\n\n  //if (status === 'INVALID_LEAD') { skipped.push({ lead_id: r.lead_id, reason: 'INVALID_LEAD' }); continue; }\n\n  if ((status === 'CALL_IN_PROGRESS' || status === 'DIALING') && r.last_call_time) {\n    const minsSince = (now - new Date(r.last_call_time).getTime()) / 60000;\n    if (minsSince > STUCK_TIMEOUT_MIN) {\n      status = 'READY_TO_CALL'; r.status = 'READY_TO_CALL';\n    } else {\n      skipped.push({ lead_id: r.lead_id, reason: `${status} since ${minsSince.toFixed(0)}min` }); continue;\n    }\n  }\n\n  // Cooldown de reintento para fallos recientes — no dispara en el ciclo inmediato\n  if ((status === 'DIAL_FAILED') && r.last_call_time) {\n    const minsSince = (now - new Date(r.last_call_time).getTime()) / 60000;\n    if (minsSince < RETRY_COOLDOWN_MIN) {\n      skipped.push({ lead_id: r.lead_id, reason: `DIAL_FAILED cooldown ${minsSince.toFixed(1)}min` }); continue;\n    }\n    status = 'READY_TO_CALL'; r.status = 'READY_TO_CALL';\n  }\n\n  if (attemptsCount >= 3) { skipped.push({ lead_id: r.lead_id, reason: `attempts=${attemptsCount}` }); continue; }\n  if (SKIP_STATUSES.has(status)) { skipped.push({ lead_id: r.lead_id, reason: `status=${status}` }); continue; }\n\n  if (status === 'SCHEDULED') { skipped.push({ lead_id: r.lead_id, reason: 'SCHEDULED → lo maneja WF4' }); continue; }\n\n  r.phone = phone;\n  r.full_name = String(r.full_name || '').trim() || 'User';\n  r.lead_id = String(r.lead_id).trim();\n\n  const phoneStr = String(phone);\n  let country = String(r.country || '').trim();\n  if (!country || country.length < 2) {\n    if (phoneStr.startsWith('+91')) country = 'India';\n    else if (phoneStr.startsWith('+971')) country = 'UAE';\n    else if (phoneStr.startsWith('+92')) country = 'Pakistan';\n    else if (phoneStr.startsWith('+1')) country = 'USA';\n    else if (phoneStr.startsWith('+880')) country = 'Bangladesh';\n    else country = 'India';\n  }\n  r.country = country;\n\n  attempts.push({ json: r });\n}\n\nconsole.log('🟢 ELEGIBLES', attempts.length, '| ⚪ SKIPPED', skipped.length, JSON.stringify(skipped));\n\nif (attempts.length === 0) return [];\n\n// Prioridad estricta: nuevos primero, retries solo si sobra cupo\nconst nuevos     = attempts.filter(a => Number(a.json.call_attempts || 0) === 0);\nconst reintentos = attempts.filter(a => Number(a.json.call_attempts || 0) > 0);\n\nconst batch = [...nuevos, ...reintentos].slice(0, BATCH_SIZE);\n\nconsole.log(`📦 Batch: ${batch.length}/${BATCH_SIZE} | Nuevos disponibles: ${nuevos.length} | Reintentos disponibles: ${reintentos.length}`);\nreturn batch;"
      },
