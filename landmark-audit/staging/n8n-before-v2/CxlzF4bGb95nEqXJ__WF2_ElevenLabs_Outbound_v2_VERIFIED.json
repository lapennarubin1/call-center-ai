      "parameters": {
        "jsCode": "const items = $input.all();\nconst leads = $('⚙️ Normalize & Select1').all();\nconst now = new Date().toISOString();\nconst cooldownDate = new Date(Date.now() + 3 * 60 * 60 * 1000).toISOString();\n\nreturn items.map((item, i) => {\n  const resp = item.json || {};\n  const lead = (leads[i] || leads[0]).json;\n\n  const statusCode = resp.statusCode ?? resp.status ?? (resp.headers ? 200 : null);\n  const body = resp.body ?? resp;\n  const conversationId = body.conversation_id || body.conversationId || body.call_sid || body.callSid || '';\n\n  let status, last_call_status, notes, callback_date;\n\n  if (statusCode && statusCode >= 200 && statusCode < 300 && conversationId) {\n    status = 'CALL_IN_PROGRESS';\n    last_call_status = 'INITIATED';\n    notes = '🟢 Dial sent: ' + conversationId;\n    callback_date = '';\n  } else if (statusCode && statusCode >= 400) {\n    status = 'DIAL_FAILED';\n    last_call_status = 'HTTP_' + statusCode;\n    notes = '🔴 ElevenLabs ' + statusCode + ': ' + JSON.stringify(body).slice(0, 200);\n    callback_date = cooldownDate;\n  } else {\n    status = 'DIAL_FAILED';\n    last_call_status = 'NO_CONV_ID';\n    notes = '🟡 Unexpected: ' + JSON.stringify(body).slice(0, 200);\n    callback_date = cooldownDate;\n  }\n\n  console.log('📞 v5 —', lead.lead_id, '| HTTP', statusCode, '| status:', status, '| conv_id:', conversationId);\n\n  return { json: {\n    lead_id: lead.lead_id,\n    elevenlabs_call_id: conversationId,\n    status,\n    last_call_status,\n    notes,\n    callback_date,\n    call_attempts: Number(lead.call_attempts || 0) + 1,\n    last_call_time: now\n  }};\n});"
      },
