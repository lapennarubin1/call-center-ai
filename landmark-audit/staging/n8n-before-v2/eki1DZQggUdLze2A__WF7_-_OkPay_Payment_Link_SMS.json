    {
      "parameters": {
        "jsCode": "// HARD GUARD — refuses bad inputs before we ever sign an OkPay request.\nconst j = $input.first().json || {};\nconst lead_id   = String(j.lead_id || '').trim();\nconst full_name = String(j.full_name || '').trim();\nconst phone     = String(j.phone || '').replace(/[^0-9]/g, '');\nconst currency  = String(j.currency || 'INR').trim().toUpperCase();\nconst amountRaw = j.amount;\nconst amountNum = Number(String(amountRaw || '0').replace(/^=/, '').trim());\nconst riskConfirmed = j.risk_disclosure_confirmed === true || j.risk_disclosure_confirmed === 'true';\n\n// Fix whatsapp_phone — lista negra de números Twilio\nconst TWILIO_NUMBERS = ['917827796280', '16514170638'];\nlet whatsapp_phone = String(j.whatsapp_phone || '').replace(/[^0-9]/g, '');\nif (!whatsapp_phone || TWILIO_NUMBERS.includes(whatsapp_phone)) {\n  whatsapp_phone = phone;\n}\nif (whatsapp_phone.length === 10) {\n  whatsapp_phone = '+91' + whatsapp_phone;\n} else if (!whatsapp_phone.startsWith('+')) {\n  whatsapp_phone = '+' + whatsapp_phone;\n}\n\nconst errs = [];\nif (!lead_id) errs.push('missing lead_id');\nif (!phone) errs.push('missing phone');\nif (!['INR', 'PKR', 'BDT', 'JPY'].includes(currency)) errs.push('unsupported currency ' + currency);\nif (!Number.isFinite(amountNum) || amountNum < 2000) errs.push('amount must be >= 2000');\nif (amountNum > 500000) errs.push('amount exceeds sanity ceiling 500000');\nif (!riskConfirmed) errs.push('risk_disclosure_confirmed must be true');\n\nif (errs.length) {\n  return [{ json: {\n    success: false,\n    refused: true,\n    reason: errs.join('; '),\n    user_message: 'Sorry, payment link nahi bana sakti. Reason: ' + errs.join(', ')\n  }}];\n}\n\nconst out_trade_no = 'LM_' + lead_id + '_' + Date.now();\nconst idempotency_key = 'pay_' + out_trade_no;\n\nreturn [{ json: {\n  ok: true,\n  lead_id, full_name, phone, whatsapp_phone, currency,\n  amount: String(Math.floor(amountNum)),\n  out_trade_no, idempotency_key\n}}];"
      },
