        "mode": "runOnceForEachItem",
        "jsCode": "\n// ElevenLabs manda: { caller_id: \"+91XXXXXXXXXX\", called_number: \"+91797...\", agent_id: \"...\" }\nconst body = $input.item.json.body || $input.item.json;\nconst callerRaw = String(body.caller_id || body.from || body.phone || '').replace(/[^0-9]/g,'');\n// Normalizar a E.164 sin +\nconst caller = callerRaw.length >= 10 ? callerRaw : '';\nconsole.log('📞 ElevenLabs init | caller_id raw:', body.caller_id, '| normalized:', caller);\nreturn { json: { caller } };\n"
      },
