    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\n// Si encontramos el lead, devolvemos sus datos como dynamic_variables\n// ElevenLabs los inyecta en la conversación igual que outbound\nconst lead = $input.item.json;\nconst leadId   = String(lead.lead_id   || '');\nconst fullName = String(lead.full_name || '').trim() || 'User';\nconst phone    = String(lead.phone     || '');\nconst country  = String(lead.country   || 'India');\nconst attempts = String(lead.call_attempts || '0');\n\nif (!leadId) {\n  console.warn('⚠️ Lead no encontrado por teléfono — devolviendo defaults');\n}\n\nconst response = {\n  conversation_config_override: {\n    agent: { language: 'hi' }\n  },\n  dynamic_variables: {\n    lead_id:       leadId || ('STRINGEE-' + phone),\n    full_name:     fullName,\n    phone:         phone,\n    country:       country,\n    language:      'hi',\n    is_followup:   Number(attempts) > 0 ? 'true' : 'false',\n    call_attempts: attempts\n  }\n};\n\nconsole.log('✅ Init response | lead_id:', response.dynamic_variables.lead_id);\nreturn { json: { responseBody: JSON.stringify(response) } };\n"
      },
